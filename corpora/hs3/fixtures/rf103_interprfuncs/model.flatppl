sigma = elementof(posreals)
alpha = elementof(interval(0.1, 10.0))
mean2 = elementof(interval(0.0, 200.0))
% HS3 generic_function → lowered expression
mean = sqrt(mean2)
g2 = relabel(Normal(mu = mean, sigma = sigma), ["x"])
% HS3 generic_dist → normalize(weighted(functionof(<expr>), Lebesgue(reals)))
genpdf = normalize(
  truncate(
    weighted(x -> 1.0 + 0.1 * abs(x) + sin(sqrt(abs(x * alpha + 0.1))), Lebesgue(reals)),
    interval(-20.0, 20.0),
  ),
)
default_domain = cartprod(
  alpha = interval(0.1, 10.0),
  mean2 = interval(0.0, 200.0),
  sigma = interval(0.1, 10.0),
  x = interval(-20.0, 20.0),
)
default_values = record(x = 0.0, mean2 = 10.0, sigma = 3.0, alpha = 5.0)
