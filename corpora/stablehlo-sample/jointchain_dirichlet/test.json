{
  "test_type": "sample",
  "engines": [
    "stablehlo"
  ],
  "params": {
    "alpha": [
      2.0,
      3.0,
      5.0
    ]
  },
  "inputs": [
    "alpha"
  ],
  "draws": 100000,
  "seed": 0,
  "checks": [
    "distribution",
    "key_reproducibility",
    "key_advance",
    "moment"
  ],
  "stat": {
    "distribution": {
      "family": "norm",
      "kwargs": {
        "loc": 0.0,
        "scale": 1.0
      }
    },
    "discrete": false,
    "moment": {
      "mean": 0.2
    }
  },
  "tolerance": {
    "ks_stat_max": 0.02,
    "moment_rel_tol": 0.03,
    "independence_abs_corr_max": 0.05
  }
}
