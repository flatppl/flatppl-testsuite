%%%
# Dotted cumulative ops over a vector of rows, 2 rows of 5

`cumsum.(vv)` and `cummax.(vv)` scan each of the 2 inner vectors of `vv`.
%%%
flatppl_compat = "0.1"

x = elementof(cartpow(reals, [2, 5]))
a = elementof(reals)
vv = [x[1, :], x[2, :]]
S = rowstack(cumsum.(vv))
M = rowstack(cummax.(vv))
