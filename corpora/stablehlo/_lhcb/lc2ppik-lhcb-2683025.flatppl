%%%
# Λc+ → p π+ K− (LHCb, arXiv:2208.03262)

Ported from the amplitude-serialization file `lc2ppik-lhcb-2683025.json` (distribution `default_model`) by
`json2flatppl.py`, following the decay model `CASCADEDECAYS` of EvtGen
(gitlab.cern.ch/evtgen/evtgen merge request 74).

The amplitude is the Dalitz-plot decomposition (Mikhasenko et al., PRD 101
(2020) 034033) as in ThreeBodyDecays.jl and THREEBODYDECAYS: a function of the
invariants σ1 = m²(23), σ2 = m²(31), σ3 = m²(12), with the final-state spins
aligned to the reference topology by the Wigner angles ζ. The decay rate is
this intensity times the phase-space density in the decay coordinates of the
reference topology, from which the four-momenta are built.

Parent: Lc (spin 1/2, unpolarised). Final state: 1 = p (spin 1/2), 2 = pi (spin 0), 3 = K (spin 0).
All masses in GeV. The intensity is summed over the helicities of all
particles, as in the validation values of the JSON file.
%%%
flatppl_compat = "0.1"

hep = standard_module("particle-physics", "0.1")

# ----------------------------------------------------------------------------
# Masses
# ----------------------------------------------------------------------------

m0 = 2.28646  % Lc
m1 = 0.938272046  % p
m2 = 0.13957018  % pi
m3 = 0.493677  % K
s0 = m0^2
ms1 = m1^2
ms2 = m2^2
ms3 = m3^2

# ----------------------------------------------------------------------------
# Lineshapes of the resonances, as functions of the mass squared s
# ----------------------------------------------------------------------------

% L1405_Flatte (MultichannelBreitWigner)
ls_L1405_Flatte(s) = 1 / (1.4051^2 - s - im * (0.328725260215546 * 2 * hep.breakup_momentum(sqrt(s), 0.938272046, 0.493677) / sqrt(s) + 0.328725260215546 * 2 * hep.breakup_momentum(sqrt(s), 1.18937, 0.13957018) / sqrt(s)))
% L1520_BW (BreitWigner)
ls_L1520_BW(s) = hep.resonance_breitwigner(s, 1.518467, 0.015195, 0.493677, 0.938272046, 2, 1.5)
% L1600_BW (BreitWigner)
ls_L1600_BW(s) = hep.resonance_breitwigner(s, 1.63, 0.25, 0.493677, 0.938272046, 1, 1.5)
% L1670_BW (BreitWigner)
ls_L1670_BW(s) = hep.resonance_breitwigner(s, 1.67, 0.03, 0.493677, 0.938272046, 0, 1.5)
% L1690_BW (BreitWigner)
ls_L1690_BW(s) = hep.resonance_breitwigner(s, 1.69, 0.07, 0.493677, 0.938272046, 2, 1.5)
% L2000_BW (BreitWigner)
ls_L2000_BW(s) = hep.resonance_breitwigner(s, 1.98819, 0.17926, 0.493677, 0.938272046, 0, 1.5)
% D1232_BW (BreitWigner)
ls_D1232_BW(s) = hep.resonance_breitwigner(s, 1.232, 0.117, 0.938272046, 0.13957018, 1, 1.5)
% D1600_BW (BreitWigner)
ls_D1600_BW(s) = hep.resonance_breitwigner(s, 1.64, 0.3, 0.938272046, 0.13957018, 1, 1.5)
% D1700_BW (BreitWigner)
ls_D1700_BW(s) = hep.resonance_breitwigner(s, 1.69, 0.38, 0.938272046, 0.13957018, 2, 1.5)
% K700_BuggBW (generic_function)
ls_K700_BuggBW(s) = 1/(0.824^2 - s - im * 0.824 * (s - 0.23397706275638377) / (0.824^2 - 0.23397706275638377) * 0.478 * exp(-0.941060 * s))
% K892_BW (BreitWigner)
ls_K892_BW(s) = hep.resonance_breitwigner(s, 0.8955, 0.047299999999999995, 0.13957018, 0.493677, 1, 1.5)
% K1430_BuggBW (generic_function)
ls_K1430_BuggBW(s) = 1/(1.375^2 - s - im * 1.375 * (s - 0.23397706275638377) / (1.375^2 - 0.23397706275638377) * 0.190 * exp(-0.020981 * s))

# ----------------------------------------------------------------------------
# Kinematics of the Dalitz-plot decomposition
# ----------------------------------------------------------------------------

# cos(θ) or cos(ζ) from numerator and denominator, at the edge of the Dalitz
# plot, where the denominator vanishes, the angle is set to zero
clamp_cos(num, den) = ifelse(den > 0.0, min(max(num / den, -1.0), 1.0), 1.0)
sqrt0(x) = sqrt(max(x, 0.0))
# Helicity angle of chain k with (i, j, k) cyclic: angle between i and k in the
# rest frame of (i j)
cos_theta_dpd(sk, sj, msi, msj, msk) = clamp_cos(
    2 * sk * (sj - msk - msi) - (sk + msi - msj) * (s0 - sk - msk),
    sqrt0(hep.kallen(sk, msi, msj) * hep.kallen(s0, sk, msk)))
# Wigner angles between the frames of two chains for the parent, for the
# spectator of one of the chains, and for the third particle
cos_zeta_parent(si, sj, sk, msi, msk) = clamp_cos(
    (s0 + msi - si) * (s0 + msk - sk) - 2 * s0 * (sj - msi - msk),
    sqrt0(hep.kallen(s0, msi, si) * hep.kallen(s0, msk, sk)))
cos_zeta_spectator(si, sj, sk, msj, msk) = ifelse(msk < 1e-10, 1.0, clamp_cos(
    2 * msk * (sj - s0 - msj) + (s0 + msk - sk) * (si - msk - msj),
    sqrt0(hep.kallen(s0, msk, sk) * hep.kallen(msk, msj, si))))
cos_zeta_third(si, sj, sk, msi, msj, msk) = ifelse(msk < 1e-10, 1.0, clamp_cos(
    2 * msk * (msi + msj - sk) + (si - msj - msk) * (sj - msk - msi),
    sqrt0(hep.kallen(si, msj, msk) * hep.kallen(sj, msk, msi))))

# ----------------------------------------------------------------------------
# Invariants and helicity angles of the three chains
# ----------------------------------------------------------------------------

# The amplitude is a function of the invariants, reified as decay_intensity below
sigma1 = elementof(posreals)  % m²(23)
sigma2 = elementof(posreals)  % m²(31)
sigma3 = elementof(posreals)  % m²(12)
cos_theta1 = cos_theta_dpd(sigma1, sigma3, ms2, ms3, ms1)  % chain (23)1
q1 = hep.breakup_momentum(m0, sqrt(sigma1), m1)  % momentum of 1 in the parent frame
p1 = hep.breakup_momentum(sqrt(sigma1), m2, m3)  % momentum in the (23) frame
cos_theta2 = cos_theta_dpd(sigma2, sigma1, ms3, ms1, ms2)  % chain (31)2
q2 = hep.breakup_momentum(m0, sqrt(sigma2), m2)  % momentum of 2 in the parent frame
p2 = hep.breakup_momentum(sqrt(sigma2), m3, m1)  % momentum in the (31) frame
cos_theta3 = cos_theta_dpd(sigma3, sigma2, ms1, ms2, ms3)  % chain (12)3
q3 = hep.breakup_momentum(m0, sqrt(sigma3), m3)  % momentum of 3 in the parent frame
p3 = hep.breakup_momentum(sqrt(sigma3), m1, m2)  % momentum in the (12) frame

# ----------------------------------------------------------------------------
# Decay chains: weight × sqrt(2J+1) × lineshape × form factors
# ----------------------------------------------------------------------------

% c01_L1405: L1405_Flatte, J = 1/2, chain (31)2, production: helicity coupling, 2λ = (1, 0), decay: parity coupling, 2λ = ±(0, 1), η = +
c01_L1405 = (7.38649400481717 + 1.971018433257411 * im) * sqrt(2.0) * ls_L1405_Flatte(sigma2)
% c02_L1405: L1405_Flatte, J = 1/2, chain (31)2, production: helicity coupling, 2λ = (-1, 0), decay: parity coupling, 2λ = ±(0, 1), η = +
c02_L1405 = (-3.2332358574805515 + 2.2557724553615772 * im) * sqrt(2.0) * ls_L1405_Flatte(sigma2)
% c03_L1520: L1520_BW, J = 3/2, chain (31)2, production: helicity coupling, 2λ = (-1, 0), decay: parity coupling, 2λ = ±(0, 1), η = -
c03_L1520 = (3.605175244894445 + 0.5435267843818713 * im) * sqrt(4.0) * ls_L1520_BW(sigma2) * hep.blatt_weisskopf(1, q2, 5.0) * hep.blatt_weisskopf(2, p2, 1.5)
% c04_L1520: L1520_BW, J = 3/2, chain (31)2, production: helicity coupling, 2λ = (1, 0), decay: parity coupling, 2λ = ±(0, 1), η = -
c04_L1520 = (-1.9704378756874323 + 18.379565942050206 * im) * sqrt(4.0) * ls_L1520_BW(sigma2) * hep.blatt_weisskopf(1, q2, 5.0) * hep.blatt_weisskopf(2, p2, 1.5)
% c05_L1600: L1600_BW, J = 1/2, chain (31)2, production: helicity coupling, 2λ = (1, 0), decay: parity coupling, 2λ = ±(0, 1), η = -
c05_L1600 = (10.062771632071723 - 1.2160303664881582 * im) * sqrt(2.0) * ls_L1600_BW(sigma2) * hep.blatt_weisskopf(1, p2, 1.5)
% c06_L1600: L1600_BW, J = 1/2, chain (31)2, production: helicity coupling, 2λ = (-1, 0), decay: parity coupling, 2λ = ±(0, 1), η = -
c06_L1600 = (-6.987335732146143 - 4.449911731331869 * im) * sqrt(2.0) * ls_L1600_BW(sigma2) * hep.blatt_weisskopf(1, p2, 1.5)
% c07_L1670: L1670_BW, J = 1/2, chain (31)2, production: helicity coupling, 2λ = (-1, 0), decay: parity coupling, 2λ = ±(0, 1), η = +
c07_L1670 = (-0.24012285628923374 - 0.10230279488850731 * im) * sqrt(2.0) * ls_L1670_BW(sigma2)
% c08_L1670: L1670_BW, J = 1/2, chain (31)2, production: helicity coupling, 2λ = (1, 0), decay: parity coupling, 2λ = ±(0, 1), η = +
c08_L1670 = (-0.40374241570833247 + 0.7154739757283278 * im) * sqrt(2.0) * ls_L1670_BW(sigma2)
% c09_L1690: L1690_BW, J = 3/2, chain (31)2, production: helicity coupling, 2λ = (-1, 0), decay: parity coupling, 2λ = ±(0, 1), η = -
c09_L1690 = (-1.5899154261176556 - 0.4543210160355851 * im) * sqrt(4.0) * ls_L1690_BW(sigma2) * hep.blatt_weisskopf(1, q2, 5.0) * hep.blatt_weisskopf(2, p2, 1.5)
% c10_L1690: L1690_BW, J = 3/2, chain (31)2, production: helicity coupling, 2λ = (1, 0), decay: parity coupling, 2λ = ±(0, 1), η = -
c10_L1690 = (-11.25382439169629 - 1.4573757648967332 * im) * sqrt(4.0) * ls_L1690_BW(sigma2) * hep.blatt_weisskopf(1, q2, 5.0) * hep.blatt_weisskopf(2, p2, 1.5)
% c11_L2000: L2000_BW, J = 1/2, chain (31)2, production: helicity coupling, 2λ = (1, 0), decay: parity coupling, 2λ = ±(0, 1), η = +
c11_L2000 = (-3.0661953154540726 - 2.684313105886122 * im) * sqrt(2.0) * ls_L2000_BW(sigma2)
% c12_L2000: L2000_BW, J = 1/2, chain (31)2, production: helicity coupling, 2λ = (-1, 0), decay: parity coupling, 2λ = ±(0, 1), η = +
c12_L2000 = (-5.667359734940468 - 5.38391527459506 * im) * sqrt(2.0) * ls_L2000_BW(sigma2)
% c13_D1232: D1232_BW, J = 3/2, chain (12)3, production: helicity coupling, 2λ = (-1, 0), decay: parity coupling, 2λ = ±(1, 0), η = +
c13_D1232 = (-10.91657692017265 + 4.915067165836356 * im) * sqrt(4.0) * ls_D1232_BW(sigma3) * hep.blatt_weisskopf(1, q3, 5.0) * hep.blatt_weisskopf(1, p3, 1.5)
% c14_D1232: D1232_BW, J = 3/2, chain (12)3, production: helicity coupling, 2λ = (1, 0), decay: parity coupling, 2λ = ±(1, 0), η = +
c14_D1232 = (-20.916449737345527 + 7.29308576054982 * im) * sqrt(4.0) * ls_D1232_BW(sigma3) * hep.blatt_weisskopf(1, q3, 5.0) * hep.blatt_weisskopf(1, p3, 1.5)
% c15_D1600: D1600_BW, J = 3/2, chain (12)3, production: helicity coupling, 2λ = (-1, 0), decay: parity coupling, 2λ = ±(1, 0), η = +
c15_D1600 = (10.394484212696474 - 2.8494349466419946 * im) * sqrt(4.0) * ls_D1600_BW(sigma3) * hep.blatt_weisskopf(1, q3, 5.0) * hep.blatt_weisskopf(1, p3, 1.5)
% c16_D1600: D1600_BW, J = 3/2, chain (12)3, production: helicity coupling, 2λ = (1, 0), decay: parity coupling, 2λ = ±(1, 0), η = +
c16_D1600 = (6.134820509903093 - 0.9138426164937006 * im) * sqrt(4.0) * ls_D1600_BW(sigma3) * hep.blatt_weisskopf(1, q3, 5.0) * hep.blatt_weisskopf(1, p3, 1.5)
% c17_D1700: D1700_BW, J = 3/2, chain (12)3, production: helicity coupling, 2λ = (-1, 0), decay: parity coupling, 2λ = ±(1, 0), η = -
c17_D1700 = (-29.25264941105087 - 4.044389587266232 * im) * sqrt(4.0) * ls_D1700_BW(sigma3) * hep.blatt_weisskopf(1, q3, 5.0) * hep.blatt_weisskopf(2, p3, 1.5)
% c18_D1700: D1700_BW, J = 3/2, chain (12)3, production: helicity coupling, 2λ = (1, 0), decay: parity coupling, 2λ = ±(1, 0), η = -
c18_D1700 = (-36.28747656529877 - 5.93484672030687 * im) * sqrt(4.0) * ls_D1700_BW(sigma3) * hep.blatt_weisskopf(1, q3, 5.0) * hep.blatt_weisskopf(2, p3, 1.5)
% c19_K700: K700_BuggBW, J = 0, chain (23)1, production: helicity coupling, 2λ = (0, 1), decay: parity coupling, 2λ = ±(0, 0), η = +
c19_K700 = (0.068908 + 2.521444 * im) * sqrt(1.0) * ls_K700_BuggBW(sigma1)
% c20_K700: K700_BuggBW, J = 0, chain (23)1, production: helicity coupling, 2λ = (0, -1), decay: parity coupling, 2λ = ±(0, 0), η = +
c20_K700 = (-2.68563 + 0.03849 * im) * sqrt(1.0) * ls_K700_BuggBW(sigma1)
% c21_K892: K892_BW, J = 1, chain (23)1, production: helicity coupling, 2λ = (-2, -1), decay: parity coupling, 2λ = ±(0, 0), η = +
c21_K892 = (1.7222349176997693 - 1.481361689419436 * im) * sqrt(3.0) * ls_K892_BW(sigma1) * hep.blatt_weisskopf(1, p1, 1.5)
% c22_K892: K892_BW, J = 1, chain (23)1, production: helicity coupling, 2λ = (0, 1), decay: parity coupling, 2λ = ±(0, 0), η = +
c22_K892 = (-1.0500585346397064 - 6.000208435743097 * im) * sqrt(3.0) * ls_K892_BW(sigma1) * hep.blatt_weisskopf(1, p1, 1.5)
% c23_K892: K892_BW, J = 1, chain (23)1, production: helicity coupling, 2λ = (0, -1), decay: parity coupling, 2λ = ±(0, 0), η = +
c23_K892 = 1.4440841024000803 * sqrt(3.0) * ls_K892_BW(sigma1) * hep.blatt_weisskopf(1, p1, 1.5)
% c24_K892: K892_BW, J = 1, chain (23)1, production: helicity coupling, 2λ = (2, 1), decay: parity coupling, 2λ = ±(0, 0), η = +
c24_K892 = (-4.536512227148323 - 4.755961023685448 * im) * sqrt(3.0) * ls_K892_BW(sigma1) * hep.blatt_weisskopf(1, p1, 1.5)
% c25_K1430: K1430_BuggBW, J = 0, chain (23)1, production: helicity coupling, 2λ = (0, 1), decay: parity coupling, 2λ = ±(0, 0), η = +
c25_K1430 = (-6.71516 + 10.479411 * im) * sqrt(1.0) * ls_K1430_BuggBW(sigma1)
% c26_K1430: K1430_BuggBW, J = 0, chain (23)1, production: helicity coupling, 2λ = (0, -1), decay: parity coupling, 2λ = ±(0, 0), η = +
c26_K1430 = (0.219754 + 8.741196 * im) * sqrt(1.0) * ls_K1430_BuggBW(sigma1)

# ----------------------------------------------------------------------------
# Wigner d-functions of the helicity angles
# ----------------------------------------------------------------------------

d1_0_0_0 = hep.wignerd_doublearg(0, 0, 0, cos_theta1)
d1_2_0_0 = hep.wignerd_doublearg(2, 0, 0, cos_theta1)
d1_2_m2_0 = hep.wignerd_doublearg(2, -2, 0, cos_theta1)
d1_2_p2_0 = hep.wignerd_doublearg(2, 2, 0, cos_theta1)
d2_1_m1_m1 = hep.wignerd_doublearg(1, -1, -1, cos_theta2)
d2_1_m1_p1 = hep.wignerd_doublearg(1, -1, 1, cos_theta2)
d2_1_p1_m1 = hep.wignerd_doublearg(1, 1, -1, cos_theta2)
d2_1_p1_p1 = hep.wignerd_doublearg(1, 1, 1, cos_theta2)
d2_3_m1_m1 = hep.wignerd_doublearg(3, -1, -1, cos_theta2)
d2_3_m1_p1 = hep.wignerd_doublearg(3, -1, 1, cos_theta2)
d2_3_p1_m1 = hep.wignerd_doublearg(3, 1, -1, cos_theta2)
d2_3_p1_p1 = hep.wignerd_doublearg(3, 1, 1, cos_theta2)
d3_3_m1_m1 = hep.wignerd_doublearg(3, -1, -1, cos_theta3)
d3_3_m1_p1 = hep.wignerd_doublearg(3, -1, 1, cos_theta3)
d3_3_p1_m1 = hep.wignerd_doublearg(3, 1, -1, cos_theta3)
d3_3_p1_p1 = hep.wignerd_doublearg(3, 1, 1, cos_theta3)

# ----------------------------------------------------------------------------
# Amplitudes of each chain group in its own frames
# ----------------------------------------------------------------------------

% A<k>_<particle>_<2λ>...: chains with spectator k, p1 = +1/2, m1 = -1/2, p2 = +1, ...
A1_p_m1_Lc_m1 = -c21_K892 * d1_2_m2_0
A1_p_m1_Lc_p1 = (
    -c20_K700 * d1_0_0_0
    - c23_K892 * d1_2_0_0
    - c26_K1430 * d1_0_0_0
)
A1_p_p1_Lc_m1 = (
    c19_K700 * d1_0_0_0
    + c22_K892 * d1_2_0_0
    + c25_K1430 * d1_0_0_0
)
A1_p_p1_Lc_p1 = c24_K892 * d1_2_p2_0
A2_p_m1_Lc_m1 = (
    -c02_L1405 * d2_1_m1_p1
    + c03_L1520 * d2_3_m1_p1
    + c06_L1600 * d2_1_m1_p1
    - c07_L1670 * d2_1_m1_p1
    + c09_L1690 * d2_3_m1_p1
    - c12_L2000 * d2_1_m1_p1
)
A2_p_m1_Lc_p1 = (
    -c01_L1405 * d2_1_p1_p1
    + c04_L1520 * d2_3_p1_p1
    + c05_L1600 * d2_1_p1_p1
    - c08_L1670 * d2_1_p1_p1
    + c10_L1690 * d2_3_p1_p1
    - c11_L2000 * d2_1_p1_p1
)
A2_p_p1_Lc_m1 = (
    c02_L1405 * d2_1_m1_m1
    + c03_L1520 * d2_3_m1_m1
    + c06_L1600 * d2_1_m1_m1
    + c07_L1670 * d2_1_m1_m1
    + c09_L1690 * d2_3_m1_m1
    + c12_L2000 * d2_1_m1_m1
)
A2_p_p1_Lc_p1 = (
    c01_L1405 * d2_1_p1_m1
    + c04_L1520 * d2_3_p1_m1
    + c05_L1600 * d2_1_p1_m1
    + c08_L1670 * d2_1_p1_m1
    + c10_L1690 * d2_3_p1_m1
    + c11_L2000 * d2_1_p1_m1
)
A3_p_m1_Lc_m1 = (
    c13_D1232 * d3_3_m1_m1
    + c15_D1600 * d3_3_m1_m1
    - c17_D1700 * d3_3_m1_m1
)
A3_p_m1_Lc_p1 = (
    c14_D1232 * d3_3_p1_m1
    + c16_D1600 * d3_3_p1_m1
    - c18_D1700 * d3_3_p1_m1
)
A3_p_p1_Lc_m1 = (
    c13_D1232 * d3_3_m1_p1
    + c15_D1600 * d3_3_m1_p1
    + c17_D1700 * d3_3_m1_p1
)
A3_p_p1_Lc_p1 = (
    c14_D1232 * d3_3_p1_p1
    + c16_D1600 * d3_3_p1_p1
    + c18_D1700 * d3_3_p1_p1
)

# ----------------------------------------------------------------------------
# Alignment of the spins to the frames of the reference chain 2
# ----------------------------------------------------------------------------

# A particle with spin is rotated by its Wigner angle ζ between the frames of
# chain k and the reference chain (THREEBODYDECAYS, ThreeBodyDecays.jl).
cos_zeta1_p = cos_zeta_spectator(sigma2, sigma3, sigma1, ms3, ms1)
dz1_p_m1_m1 = hep.wignerd_doublearg(1, -1, -1, cos_zeta1_p)
dz1_p_m1_p1 = hep.wignerd_doublearg(1, -1, 1, cos_zeta1_p)
dz1_p_p1_m1 = hep.wignerd_doublearg(1, 1, -1, cos_zeta1_p)
dz1_p_p1_p1 = hep.wignerd_doublearg(1, 1, 1, cos_zeta1_p)
cos_zeta2_Lc = cos_zeta_parent(sigma2, sigma3, sigma1, ms2, ms1)
dz2_Lc_m1_m1 = hep.wignerd_doublearg(1, -1, -1, cos_zeta2_Lc)
dz2_Lc_m1_p1 = hep.wignerd_doublearg(1, -1, 1, cos_zeta2_Lc)
dz2_Lc_p1_m1 = hep.wignerd_doublearg(1, 1, -1, cos_zeta2_Lc)
dz2_Lc_p1_p1 = hep.wignerd_doublearg(1, 1, 1, cos_zeta2_Lc)
cos_zeta3_p = cos_zeta_third(sigma2, sigma3, sigma1, ms2, ms3, ms1)
dz3_p_m1_m1 = hep.wignerd_doublearg(1, -1, -1, cos_zeta3_p)
dz3_p_m1_p1 = hep.wignerd_doublearg(1, -1, 1, cos_zeta3_p)
dz3_p_p1_m1 = hep.wignerd_doublearg(1, 1, -1, cos_zeta3_p)
dz3_p_p1_p1 = hep.wignerd_doublearg(1, 1, 1, cos_zeta3_p)
cos_zeta3_Lc = cos_zeta_parent(sigma1, sigma2, sigma3, ms1, ms3)
dz3_Lc_m1_m1 = hep.wignerd_doublearg(1, -1, -1, cos_zeta3_Lc)
dz3_Lc_m1_p1 = hep.wignerd_doublearg(1, -1, 1, cos_zeta3_Lc)
dz3_Lc_p1_m1 = hep.wignerd_doublearg(1, 1, -1, cos_zeta3_Lc)
dz3_Lc_p1_p1 = hep.wignerd_doublearg(1, 1, 1, cos_zeta3_Lc)

# ----------------------------------------------------------------------------
# Amplitudes in the frames of the reference chain and the intensity
# ----------------------------------------------------------------------------

A_p_m1_Lc_m1 = (
    dz1_p_m1_m1 * A1_p_m1_Lc_m1
    - dz1_p_p1_m1 * A1_p_p1_Lc_m1
    + dz2_Lc_m1_m1 * A2_p_m1_Lc_m1
    - dz2_Lc_m1_p1 * A2_p_m1_Lc_p1
    + dz3_p_m1_m1 * dz3_Lc_m1_m1 * A3_p_m1_Lc_m1
    + dz3_p_m1_m1 * dz3_Lc_m1_p1 * A3_p_m1_Lc_p1
    - dz3_p_p1_m1 * dz3_Lc_m1_m1 * A3_p_p1_Lc_m1
    - dz3_p_p1_m1 * dz3_Lc_m1_p1 * A3_p_p1_Lc_p1
)
A_p_m1_Lc_p1 = (
    dz1_p_m1_m1 * A1_p_m1_Lc_p1
    - dz1_p_p1_m1 * A1_p_p1_Lc_p1
    - dz2_Lc_p1_m1 * A2_p_m1_Lc_m1
    + dz2_Lc_p1_p1 * A2_p_m1_Lc_p1
    + dz3_p_m1_m1 * dz3_Lc_p1_m1 * A3_p_m1_Lc_m1
    + dz3_p_m1_m1 * dz3_Lc_p1_p1 * A3_p_m1_Lc_p1
    - dz3_p_p1_m1 * dz3_Lc_p1_m1 * A3_p_p1_Lc_m1
    - dz3_p_p1_m1 * dz3_Lc_p1_p1 * A3_p_p1_Lc_p1
)
A_p_p1_Lc_m1 = (
    -dz1_p_m1_p1 * A1_p_m1_Lc_m1
    + dz1_p_p1_p1 * A1_p_p1_Lc_m1
    + dz2_Lc_m1_m1 * A2_p_p1_Lc_m1
    - dz2_Lc_m1_p1 * A2_p_p1_Lc_p1
    - dz3_p_m1_p1 * dz3_Lc_m1_m1 * A3_p_m1_Lc_m1
    - dz3_p_m1_p1 * dz3_Lc_m1_p1 * A3_p_m1_Lc_p1
    + dz3_p_p1_p1 * dz3_Lc_m1_m1 * A3_p_p1_Lc_m1
    + dz3_p_p1_p1 * dz3_Lc_m1_p1 * A3_p_p1_Lc_p1
)
A_p_p1_Lc_p1 = (
    -dz1_p_m1_p1 * A1_p_m1_Lc_p1
    + dz1_p_p1_p1 * A1_p_p1_Lc_p1
    - dz2_Lc_p1_m1 * A2_p_p1_Lc_m1
    + dz2_Lc_p1_p1 * A2_p_p1_Lc_p1
    - dz3_p_m1_p1 * dz3_Lc_p1_m1 * A3_p_m1_Lc_m1
    - dz3_p_m1_p1 * dz3_Lc_p1_p1 * A3_p_m1_Lc_p1
    + dz3_p_p1_p1 * dz3_Lc_p1_m1 * A3_p_p1_Lc_m1
    + dz3_p_p1_p1 * dz3_Lc_p1_p1 * A3_p_p1_Lc_p1
)

intensity = (
    abs2(A_p_m1_Lc_m1)
    + abs2(A_p_m1_Lc_p1)
    + abs2(A_p_p1_Lc_m1)
    + abs2(A_p_p1_Lc_p1)
)

% The intensity as a function of the invariants
intensity_of_sigmas = functionof(intensity, sigma1, sigma2, sigma3)

# ----------------------------------------------------------------------------
# Four-vectors [E, px, py, pz] and the frames of the decay cascade
# ----------------------------------------------------------------------------

% Invariant mass squared
mass2(p) = p[1]^2 - p[2]^2 - p[3]^2 - p[4]^2
abs3(p) = sqrt(p[2]^2 + p[3]^2 + p[4]^2)
% Momentum of magnitude q in the direction (cos θ, φ), and the momentum opposite to p
momentum(q, cos_t, phi, m) = [sqrt(q^2 + m^2), q * sqrt(max(1 - cos_t^2, 0.0)) * cos(phi),
    q * sqrt(max(1 - cos_t^2, 0.0)) * sin(phi), q * cos_t]
opposite(p, m) = [sqrt(abs3(p)^2 + m^2), -p[2], -p[3], -p[4]]
% Active rotations about z and y and a boost along z
rot_z(p, a) = [p[1], p[2] * cos(a) - p[3] * sin(a), p[2] * sin(a) + p[3] * cos(a), p[4]]
rot_y(p, a) = [p[1], p[4] * sin(a) + p[2] * cos(a), p[3], p[4] * cos(a) - p[2] * sin(a)]
boost_z(p, g, bg) = [g * p[1] + bg * p[4], p[2], p[3], g * p[4] + bg * p[1]]
# Angles of the momentum P of a line in the frame of its parent, sgn = -1 for the
# second child of a vertex, whose frame is reached along -z (Jacob-Wick convention)
phi_of(P, sgn) = atan2(sgn * P[3], sgn * P[2])
theta_of(P, sgn) = atan2(sqrt(P[2]^2 + P[3]^2), sgn * P[4])
second_turn(sgn) = ifelse(sgn < 0, pi, 0.0)
% Momentum p in the helicity frame of the line with momentum P, and back
to_frame(p, P, sgn) = boost_z(rot_y(rot_y(rot_z(p, -phi_of(P, sgn)), -theta_of(P, sgn)),
    -second_turn(sgn)), P[1] / sqrt(mass2(P)), -abs3(P) / sqrt(mass2(P)))
from_frame(p, P, sgn) = rot_z(rot_y(rot_y(boost_z(p, P[1] / sqrt(mass2(P)),
    abs3(P) / sqrt(mass2(P))), second_turn(sgn)), theta_of(P, sgn)), phi_of(P, sgn))
% Helicity angles of a momentum in the current frame
cos_theta_dir(p) = p[4] / abs3(p)
phi_dir(p) = atan2(p[3], p[2])

# ----------------------------------------------------------------------------
# Decay coordinates of the reference topology [[3, 1], 2] and the four-momenta
# ----------------------------------------------------------------------------

# The coordinates of a node are the invariant mass m_<node> of the line and the
# helicity angles cos_theta_<node>, phi_<node> of its first child in its helicity
# frame, as the variables of the JSON file.
cos_theta_31_2 = elementof(interval(-1.0, 1.0))
phi_31_2 = elementof(interval(-pi, pi))
m_31 = elementof(interval(m3 + m1, m0 - m2))
cos_theta_31 = elementof(interval(-1.0, 1.0))
phi_31 = elementof(interval(-pi, pi))

q_31_2 = hep.breakup_momentum(m0, m_31, m2)
e_31_in_31_2 = momentum(q_31_2, cos_theta_31_2, phi_31_2, m_31)
e_2_in_31_2 = opposite(e_31_in_31_2, m2)
q_31 = hep.breakup_momentum(m_31, m3, m1)
e_3_in_31 = momentum(q_31, cos_theta_31, phi_31, m3)
e_1_in_31 = opposite(e_3_in_31, m1)
e3_31 = e_3_in_31
e1_31 = e_1_in_31
e3_31_2 = from_frame(e3_31, e_31_in_31_2, 1.0)
e1_31_2 = from_frame(e1_31, e_31_in_31_2, 1.0)
e2_31_2 = e_2_in_31_2

% Four-momenta in the rest frame of the parent
e1 = e1_31_2
e2 = e2_31_2
e3 = e3_31_2

% Invariants of the event and its intensity
sigma1_event = mass2(e2 + e3)
sigma2_event = mass2(e3 + e1)
sigma3_event = mass2(e1 + e2)
intensity_event = intensity_of_sigmas(sigma1_event, sigma2_event, sigma3_event)

# ----------------------------------------------------------------------------
# Decay rate, decay distribution and generated events
# ----------------------------------------------------------------------------

% Phase-space density in the decay coordinates: dΦ3 ∝ q p dm dΩ dΩ
phase_space_density = q_31_2 * q_31
rate = phase_space_density * intensity_event
decay_intensity = functionof(intensity_event, cos_theta_31_2, phi_31_2, m_31, cos_theta_31, phi_31)
rate_fn = functionof(rate, cos_theta_31_2, phi_31_2, m_31, cos_theta_31, phi_31)
decay_space = cartprod(cos_theta_31_2 = interval(-1.0, 1.0), phi_31_2 = interval(-pi, pi), m_31 = interval(m3 + m1, m0 - m2), cos_theta_31 = interval(-1.0, 1.0), phi_31 = interval(-pi, pi))
decay_rate = weighted(rate_fn, Lebesgue(support = decay_space))
decay_distribution = normalize(decay_rate)

% Four-momenta in the rest frame of the parent
momenta_fn = functionof(record(p = e1, pi = e2, K = e3), cos_theta_31_2, phi_31_2, m_31, cos_theta_31, phi_31)
event_distribution = pushfwd(momenta_fn, decay_distribution)
n_events = 1000
events ~ iid(event_distribution, n_events)

# ----------------------------------------------------------------------------
# Validation values of the JSON file
# ----------------------------------------------------------------------------

# checked(value, condition) fails at load time if a value differs by more
# than 1e-6 (relative) from the reference value of the JSON file.
validation_point = record(cos_theta_31_2 = 0.0, phi_31_2 = 0.0, m_31 = 1.9101377207489973, cos_theta_31 = -0.2309352648098208, phi_31 = 0.0)
intensity_validation_point = decay_intensity(validation_point)
check_validation_point = checked(intensity_validation_point,
    abs(intensity_validation_point - 9345.853380852355) <= 1e-6 * 9345.853380852355)
check_ls_L1405_Flatte = checked(ls_L1405_Flatte(3.2),
    abs(ls_L1405_Flatte(3.2) - (-0.7480602620708737 + 0.22521439829964163 * im)) <= 1e-6 * max(1.0, abs((-0.7480602620708737 + 0.22521439829964163 * im))))
check_ls_L1690_BW = checked(ls_L1690_BW(3.2),
    abs(ls_L1690_BW(3.2) - (-1.856393035564509 + 1.3970917949874666 * im)) <= 1e-6 * max(1.0, abs((-1.856393035564509 + 1.3970917949874666 * im))))
check_ls_D1232_BW = checked(ls_D1232_BW(3.2),
    abs(ls_D1232_BW(3.2) - (-0.37559145211964445 + 0.2867197317591275 * im)) <= 1e-6 * max(1.0, abs((-0.37559145211964445 + 0.2867197317591275 * im))))
check_ls_L1520_BW = checked(ls_L1520_BW(3.2),
    abs(ls_L1520_BW(3.2) - (-0.6519026717262323 + 0.5513711741076602 * im)) <= 1e-6 * max(1.0, abs((-0.6519026717262323 + 0.5513711741076602 * im))))
check_ls_L1600_BW = checked(ls_L1600_BW(3.2),
    abs(ls_L1600_BW(3.2) - (-0.5711605382444855 + 0.8517294114907099 * im)) <= 1e-6 * max(1.0, abs((-0.5711605382444855 + 0.8517294114907099 * im))))
check_ls_L2000_BW = checked(ls_L2000_BW(3.2),
    abs(ls_L2000_BW(3.2) - (1.1399027771220511 + 0.46329136172829 * im)) <= 1e-6 * max(1.0, abs((1.1399027771220511 + 0.46329136172829 * im))))
check_ls_D1600_BW = checked(ls_D1600_BW(3.2),
    abs(ls_D1600_BW(3.2) - (-0.7542612203250671 + 0.953349114487552 * im)) <= 1e-6 * max(1.0, abs((-0.7542612203250671 + 0.953349114487552 * im))))
check_ls_D1700_BW = checked(ls_D1700_BW(3.2),
    abs(ls_D1700_BW(3.2) - (-0.32420527030886465 + 0.9152170090261661 * im)) <= 1e-6 * max(1.0, abs((-0.32420527030886465 + 0.9152170090261661 * im))))
check_ls_K892_BW = checked(ls_K892_BW(1.4),
    abs(ls_K892_BW(1.4) - (-1.6160420072107298 + 0.30076446839110044 * im)) <= 1e-6 * max(1.0, abs((-1.6160420072107298 + 0.30076446839110044 * im))))
check_ls_L1670_BW = checked(ls_L1670_BW(3.2),
    abs(ls_L1670_BW(3.2) - (-2.383989898030206 + 0.34006358781864954 * im)) <= 1e-6 * max(1.0, abs((-2.383989898030206 + 0.34006358781864954 * im))))
