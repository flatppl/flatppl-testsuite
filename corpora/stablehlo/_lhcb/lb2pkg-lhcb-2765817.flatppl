# ----------------------------------------------------------------------------
# Alignment of the spins to the frames of the reference chain 3
# ----------------------------------------------------------------------------

# A particle with spin is rotated by its Wigner angle ζ between the frames of
# chain k and the reference chain (THREEBODYDECAYS, ThreeBodyDecays.jl).
cos_zeta3_Lb = cos_zeta_parent(sigma1, sigma2, sigma3, ms1, ms3)
dz3_Lb_m1_m1 = hep.wignerd_doublearg(1, -1, -1, cos_zeta3_Lb)
dz3_Lb_m1_p1 = hep.wignerd_doublearg(1, -1, 1, cos_zeta3_Lb)
dz3_Lb_p1_m1 = hep.wignerd_doublearg(1, 1, -1, cos_zeta3_Lb)
dz3_Lb_p1_p1 = hep.wignerd_doublearg(1, 1, 1, cos_zeta3_Lb)

# ----------------------------------------------------------------------------
# Amplitudes in the frames of the reference chain and the intensity
# ----------------------------------------------------------------------------

A_p_m1_g_m2_Lb_m1 = (
    dz3_Lb_m1_m1 * A3_p_m1_g_m2_Lb_m1
    + dz3_Lb_m1_p1 * A3_p_m1_g_m2_Lb_p1
)
A_p_m1_g_m2_Lb_p1 = (
    dz3_Lb_p1_m1 * A3_p_m1_g_m2_Lb_m1
    + dz3_Lb_p1_p1 * A3_p_m1_g_m2_Lb_p1
)
A_p_m1_g_0_Lb_m1 = (
    dz3_Lb_m1_m1 * A3_p_m1_g_0_Lb_m1
    + dz3_Lb_m1_p1 * A3_p_m1_g_0_Lb_p1
)
A_p_m1_g_0_Lb_p1 = (
    dz3_Lb_p1_m1 * A3_p_m1_g_0_Lb_m1
    + dz3_Lb_p1_p1 * A3_p_m1_g_0_Lb_p1
)
A_p_m1_g_p2_Lb_m1 = (
    dz3_Lb_m1_m1 * A3_p_m1_g_p2_Lb_m1
    + dz3_Lb_m1_p1 * A3_p_m1_g_p2_Lb_p1
)
A_p_m1_g_p2_Lb_p1 = (
    dz3_Lb_p1_m1 * A3_p_m1_g_p2_Lb_m1
    + dz3_Lb_p1_p1 * A3_p_m1_g_p2_Lb_p1
)
A_p_p1_g_m2_Lb_m1 = (
    dz3_Lb_m1_m1 * A3_p_p1_g_m2_Lb_m1
    + dz3_Lb_m1_p1 * A3_p_p1_g_m2_Lb_p1
)
A_p_p1_g_m2_Lb_p1 = (
    dz3_Lb_p1_m1 * A3_p_p1_g_m2_Lb_m1
    + dz3_Lb_p1_p1 * A3_p_p1_g_m2_Lb_p1
)
A_p_p1_g_0_Lb_m1 = (
    dz3_Lb_m1_m1 * A3_p_p1_g_0_Lb_m1
    + dz3_Lb_m1_p1 * A3_p_p1_g_0_Lb_p1
)
A_p_p1_g_0_Lb_p1 = (
    dz3_Lb_p1_m1 * A3_p_p1_g_0_Lb_m1
    + dz3_Lb_p1_p1 * A3_p_p1_g_0_Lb_p1
)
A_p_p1_g_p2_Lb_m1 = (
    dz3_Lb_m1_m1 * A3_p_p1_g_p2_Lb_m1
    + dz3_Lb_m1_p1 * A3_p_p1_g_p2_Lb_p1
)
A_p_p1_g_p2_Lb_p1 = (
    dz3_Lb_p1_m1 * A3_p_p1_g_p2_Lb_m1
    + dz3_Lb_p1_p1 * A3_p_p1_g_p2_Lb_p1
)

intensity = (
    abs2(A_p_m1_g_m2_Lb_m1)
    + abs2(A_p_m1_g_m2_Lb_p1)
    + abs2(A_p_m1_g_0_Lb_m1)
    + abs2(A_p_m1_g_0_Lb_p1)
    + abs2(A_p_m1_g_p2_Lb_m1)
    + abs2(A_p_m1_g_p2_Lb_p1)
    + abs2(A_p_p1_g_m2_Lb_m1)
    + abs2(A_p_p1_g_m2_Lb_p1)
    + abs2(A_p_p1_g_0_Lb_m1)
    + abs2(A_p_p1_g_0_Lb_p1)
    + abs2(A_p_p1_g_p2_Lb_m1)
    + abs2(A_p_p1_g_p2_Lb_p1)
)

% The intensity as a function of the invariants
intensity_of_sigmas = functionof(intensity, sigma1, sigma2, sigma3)

# ----------------------------------------------------------------------------
# Four-vectors [E, px, py, pz] and the frames of the decay cascade
# ----------------------------------------------------------------------------

% Invariant mass squared
mass2(p) = p[1]^2 - p[2]^2 - p[3]^2 - p[4]^2
abs3(p) = sqrt(p[2]^2 + p[3]^2 + p[4]^2)
% Momentum of magnitude q in the direction (cos θ, φ), and the momentum opposite to p
momentum(q, cos_t, phi, m) = [sqrt(q^2 + m^2), q * sqrt(max(1 - cos_t^2, 0.0)) * cos(phi),
    q * sqrt(max(1 - cos_t^2, 0.0)) * sin(phi), q * cos_t]
opposite(p, m) = [sqrt(abs3(p)^2 + m^2), -p[2], -p[3], -p[4]]
% Active rotations about z and y and a boost along z
rot_z(p, a) = [p[1], p[2] * cos(a) - p[3] * sin(a), p[2] * sin(a) + p[3] * cos(a), p[4]]
rot_y(p, a) = [p[1], p[4] * sin(a) + p[2] * cos(a), p[3], p[4] * cos(a) - p[2] * sin(a)]
boost_z(p, g, bg) = [g * p[1] + bg * p[4], p[2], p[3], g * p[4] + bg * p[1]]
# Angles of the momentum P of a line in the frame of its parent, sgn = -1 for the
# second child of a vertex, whose frame is reached along -z (Jacob-Wick convention)
phi_of(P, sgn) = atan2(sgn * P[3], sgn * P[2])
theta_of(P, sgn) = atan2(sqrt(P[2]^2 + P[3]^2), sgn * P[4])
second_turn(sgn) = ifelse(sgn < 0, pi, 0.0)
% Momentum p in the helicity frame of the line with momentum P, and back
to_frame(p, P, sgn) = boost_z(rot_y(rot_y(rot_z(p, -phi_of(P, sgn)), -theta_of(P, sgn)),
    -second_turn(sgn)), P[1] / sqrt(mass2(P)), -abs3(P) / sqrt(mass2(P)))
from_frame(p, P, sgn) = rot_z(rot_y(rot_y(boost_z(p, P[1] / sqrt(mass2(P)),
    abs3(P) / sqrt(mass2(P))), second_turn(sgn)), theta_of(P, sgn)), phi_of(P, sgn))
% Helicity angles of a momentum in the current frame
cos_theta_dir(p) = p[4] / abs3(p)
phi_dir(p) = atan2(p[3], p[2])

# ----------------------------------------------------------------------------
# Decay coordinates of the reference topology [[1, 2], 3] and the four-momenta
# ----------------------------------------------------------------------------

# The coordinates of a node are the invariant mass m_<node> of the line and the
# helicity angles cos_theta_<node>, phi_<node> of its first child in its helicity
# frame, as the variables of the JSON file.
cos_theta_12_3 = elementof(interval(-1.0, 1.0))
phi_12_3 = elementof(interval(-pi, pi))
m_12 = elementof(interval(m1 + m2, m0 - m3))
cos_theta_12 = elementof(interval(-1.0, 1.0))
phi_12 = elementof(interval(-pi, pi))

q_12_3 = hep.breakup_momentum(m0, m_12, m3)
e_12_in_12_3 = momentum(q_12_3, cos_theta_12_3, phi_12_3, m_12)
e_3_in_12_3 = opposite(e_12_in_12_3, m3)
q_12 = hep.breakup_momentum(m_12, m1, m2)
e_1_in_12 = momentum(q_12, cos_theta_12, phi_12, m1)
e_2_in_12 = opposite(e_1_in_12, m2)
e1_12 = e_1_in_12
e2_12 = e_2_in_12
e1_12_3 = from_frame(e1_12, e_12_in_12_3, 1.0)
e2_12_3 = from_frame(e2_12, e_12_in_12_3, 1.0)
e3_12_3 = e_3_in_12_3

% Four-momenta in the rest frame of the parent
e1 = e1_12_3
e2 = e2_12_3
e3 = e3_12_3

% Invariants of the event and its intensity
sigma1_event = mass2(e2 + e3)
sigma2_event = mass2(e3 + e1)
sigma3_event = mass2(e1 + e2)
intensity_event = intensity_of_sigmas(sigma1_event, sigma2_event, sigma3_event)

# ----------------------------------------------------------------------------
# Decay rate, decay distribution and generated events
# ----------------------------------------------------------------------------

% Phase-space density in the decay coordinates: dΦ3 ∝ q p dm dΩ dΩ
phase_space_density = q_12_3 * q_12
rate = phase_space_density * intensity_event
decay_intensity = functionof(intensity_event, cos_theta_12_3, phi_12_3, m_12, cos_theta_12, phi_12)
rate_fn = functionof(rate, cos_theta_12_3, phi_12_3, m_12, cos_theta_12, phi_12)
decay_space = cartprod(cos_theta_12_3 = interval(-1.0, 1.0), phi_12_3 = interval(-pi, pi), m_12 = interval(m1 + m2, m0 - m3), cos_theta_12 = interval(-1.0, 1.0), phi_12 = interval(-pi, pi))
decay_rate = weighted(rate_fn, Lebesgue(support = decay_space))
decay_distribution = normalize(decay_rate)

% Four-momenta in the rest frame of the parent
momenta_fn = functionof(record(p = e1, K = e2, g = e3), cos_theta_12_3, phi_12_3, m_12, cos_theta_12, phi_12)
event_distribution = pushfwd(momenta_fn, decay_distribution)
n_events = 1000
events ~ iid(event_distribution, n_events)

# ----------------------------------------------------------------------------
# Validation values of the JSON file
# ----------------------------------------------------------------------------

# checked(value, condition) fails at load time if a value differs by more
# than 1e-6 (relative) from the reference value of the JSON file.
validation_point1 = record(cos_theta_12_3 = 0.0, phi_12_3 = 0.0, m_12 = 1.797004885914337, cos_theta_12 = -0.2260000000000005, phi_12 = 0.0)
intensity_validation_point1 = decay_intensity(validation_point1)
check_validation_point1 = checked(intensity_validation_point1,
    abs(intensity_validation_point1 - 645.6877782510138) <= 1e-6 * 645.6877782510138)
validation_point2 = record(cos_theta_12_3 = 0.0, phi_12_3 = 0.0, m_12 = 4.889261075050094, cos_theta_12 = -0.6259999999999996, phi_12 = 0.0)
intensity_validation_point2 = decay_intensity(validation_point2)
