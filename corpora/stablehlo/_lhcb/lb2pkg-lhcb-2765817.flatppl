%%%
# Λb0 → p K− γ (LHCb, arXiv:2403.03710)

Ported from the amplitude-serialization file `lb2pkg-lhcb-2765817.json` (distribution `default_model`) by
`json2flatppl.py`, following the decay model `CASCADEDECAYS` of EvtGen
(gitlab.cern.ch/evtgen/evtgen merge request 74).

The amplitude is the Dalitz-plot decomposition (Mikhasenko et al., PRD 101
(2020) 034033) as in ThreeBodyDecays.jl and THREEBODYDECAYS: a function of the
invariants σ1 = m²(23), σ2 = m²(31), σ3 = m²(12), with the final-state spins
aligned to the reference topology by the Wigner angles ζ. The decay rate is
this intensity times the phase-space density in the decay coordinates of the
reference topology, from which the four-momenta are built.

Parent: Lb (spin 1/2, unpolarised). Final state: 1 = p (spin 1/2), 2 = K (spin 0), 3 = g (spin 1).
All masses in GeV. The intensity is summed over the helicities of all
particles, as in the validation values of the JSON file.
%%%
flatppl_compat = "0.1"

hep = standard_module("particle-physics", "0.1")

# ----------------------------------------------------------------------------
# Masses
# ----------------------------------------------------------------------------

m0 = 5.62  % Lb
m1 = 0.938  % p
m2 = 0.493  % K
m3 = 0.0  % g
s0 = m0^2
ms1 = m1^2
ms2 = m2^2
ms3 = m3^2

# ----------------------------------------------------------------------------
# Lineshapes of the resonances, as functions of the mass squared s
# ----------------------------------------------------------------------------

% L1405_Flatte (MultichannelBreitWigner)
ls_L1405_Flatte(s) = 1 / (1.405^2 - s - im * (0.3504277764790773 * 2 * hep.breakup_momentum(sqrt(s), 0.938, 0.493) / sqrt(s) + 0.3504277764790773 * 2 * hep.breakup_momentum(sqrt(s), 1.197, 0.14) / sqrt(s)))
% L1520_BW (BreitWigner)
ls_L1520_BW(s) = hep.resonance_breitwigner(s, 1.519, 0.016, 0.938, 0.493, 2, 1.5)
% L1600_BW (BreitWigner)
ls_L1600_BW(s) = hep.resonance_breitwigner(s, 1.6, 0.2, 0.938, 0.493, 1, 1.5)
% L1680_BW (BreitWigner)
ls_L1680_BW(s) = hep.resonance_breitwigner(s, 1.674, 0.03, 0.938, 0.493, 0, 1.5)
% L1690_BW (BreitWigner)
ls_L1690_BW(s) = hep.resonance_breitwigner(s, 1.69, 0.07, 0.938, 0.493, 2, 1.5)
% L1800_BW (BreitWigner)
ls_L1800_BW(s) = hep.resonance_breitwigner(s, 1.8, 0.2, 0.938, 0.493, 0, 1.5)
% L1810_BW (BreitWigner)
ls_L1810_BW(s) = hep.resonance_breitwigner(s, 1.79, 0.11, 0.938, 0.493, 1, 1.5)
% L1820_BW (BreitWigner)
ls_L1820_BW(s) = hep.resonance_breitwigner(s, 1.82, 0.08, 0.938, 0.493, 3, 1.5)
% L1830_BW (BreitWigner)
ls_L1830_BW(s) = hep.resonance_breitwigner(s, 1.825, 0.09, 0.938, 0.493, 2, 1.5)
% L1890_BW (BreitWigner)
ls_L1890_BW(s) = hep.resonance_breitwigner(s, 1.89, 0.12, 0.938, 0.493, 1, 1.5)
% L2100_BW (BreitWigner)
ls_L2100_BW(s) = hep.resonance_breitwigner(s, 2.1, 0.2, 0.938, 0.493, 4, 1.5)
% L2110_BW (BreitWigner)
ls_L2110_BW(s) = hep.resonance_breitwigner(s, 2.09, 0.25, 0.938, 0.493, 3, 1.5)
% L2350_BW (BreitWigner)
ls_L2350_BW(s) = hep.resonance_breitwigner(s, 2.35, 0.15, 0.938, 0.493, 5, 1.5)
% LNR30_NR (Polynomial)
ls_LNR30_NR(s) = polynomial(coefficients = [1.0], x = s)

# ----------------------------------------------------------------------------
# Kinematics of the Dalitz-plot decomposition
# ----------------------------------------------------------------------------

# cos(θ) or cos(ζ) from numerator and denominator, at the edge of the Dalitz
# plot, where the denominator vanishes, the angle is set to zero
clamp_cos(num, den) = ifelse(den > 0.0, min(max(num / den, -1.0), 1.0), 1.0)
sqrt0(x) = sqrt(max(x, 0.0))
# Helicity angle of chain k with (i, j, k) cyclic: angle between i and k in the
# rest frame of (i j)
cos_theta_dpd(sk, sj, msi, msj, msk) = clamp_cos(
    2 * sk * (sj - msk - msi) - (sk + msi - msj) * (s0 - sk - msk),
    sqrt0(hep.kallen(sk, msi, msj) * hep.kallen(s0, sk, msk)))
# Wigner angles between the frames of two chains for the parent, for the
# spectator of one of the chains, and for the third particle
cos_zeta_parent(si, sj, sk, msi, msk) = clamp_cos(
    (s0 + msi - si) * (s0 + msk - sk) - 2 * s0 * (sj - msi - msk),
    sqrt0(hep.kallen(s0, msi, si) * hep.kallen(s0, msk, sk)))
cos_zeta_spectator(si, sj, sk, msj, msk) = ifelse(msk < 1e-10, 1.0, clamp_cos(
    2 * msk * (sj - s0 - msj) + (s0 + msk - sk) * (si - msk - msj),
    sqrt0(hep.kallen(s0, msk, sk) * hep.kallen(msk, msj, si))))
cos_zeta_third(si, sj, sk, msi, msj, msk) = ifelse(msk < 1e-10, 1.0, clamp_cos(
    2 * msk * (msi + msj - sk) + (si - msj - msk) * (sj - msk - msi),
    sqrt0(hep.kallen(si, msj, msk) * hep.kallen(sj, msk, msi))))

# ----------------------------------------------------------------------------
# Invariants and helicity angles of the three chains
# ----------------------------------------------------------------------------

# The amplitude is a function of the invariants, reified as decay_intensity below
sigma1 = elementof(posreals)  % m²(23)
sigma2 = elementof(posreals)  % m²(31)
sigma3 = elementof(posreals)  % m²(12)
cos_theta3 = cos_theta_dpd(sigma3, sigma2, ms1, ms2, ms3)  % chain (12)3
q3 = hep.breakup_momentum(m0, sqrt(sigma3), m3)  % momentum of 3 in the parent frame
p3 = hep.breakup_momentum(sqrt(sigma3), m1, m2)  % momentum in the (12) frame

# ----------------------------------------------------------------------------
# Decay chains: weight × sqrt(2J+1) × lineshape × form factors
# ----------------------------------------------------------------------------

% c01_L1405: L1405_Flatte, J = 1/2, chain (12)3, production: LS coupling, L = 0, S = 1/2, decay: LS coupling, L = 0, S = 1/2
c01_L1405 = (2.2615419999999995 - 1.7992479999999997 * im) * sqrt(2.0) * ls_L1405_Flatte(sigma3)
% c02_L1405: L1405_Flatte, J = 1/2, chain (12)3, production: LS coupling, L = 1, S = 1/2, decay: LS coupling, L = 0, S = 1/2
c02_L1405 = (-1.8715784466594079 - 1.0439686414131668 * im) * sqrt(2.0) * ls_L1405_Flatte(sigma3) * hep.blatt_weisskopf(1, q3, 5.0)
% c03_L1405: L1405_Flatte, J = 1/2, chain (12)3, production: LS coupling, L = 1, S = 3/2, decay: LS coupling, L = 0, S = 1/2
c03_L1405 = (1.3234058111554519 + 0.7381973056893572 * im) * sqrt(2.0) * ls_L1405_Flatte(sigma3) * hep.blatt_weisskopf(1, q3, 5.0)
% c04_L1405: L1405_Flatte, J = 1/2, chain (12)3, production: LS coupling, L = 2, S = 3/2, decay: LS coupling, L = 0, S = 1/2
c04_L1405 = (-1.6131550895688382 + 1.283401355622205 * im) * sqrt(2.0) * ls_L1405_Flatte(sigma3) * hep.blatt_weisskopf(2, q3, 5.0)
% c05_L1520: L1520_BW, J = 3/2, chain (12)3, production: LS coupling, L = 0, S = 1/2, decay: LS coupling, L = 2, S = 1/2
c05_L1520 = (4.108357043622831 - 0.0668483592242114 * im) * sqrt(4.0) * ls_L1520_BW(sigma3) * hep.blatt_weisskopf(2, p3, 1.5)
% c06_L1520: L1520_BW, J = 3/2, chain (12)3, production: LS coupling, L = 1, S = 1/2, decay: LS coupling, L = 2, S = 1/2
c06_L1520 = (5.529490890260219 + 0.8175133786512758 * im) * sqrt(4.0) * ls_L1520_BW(sigma3) * hep.blatt_weisskopf(1, q3, 5.0) * hep.blatt_weisskopf(2, p3, 1.5)
% c07_L1520: L1520_BW, J = 3/2, chain (12)3, production: LS coupling, L = 1, S = 3/2, decay: LS coupling, L = 2, S = 1/2
c07_L1520 = (-1.669745451910645 + 21.202140697865232 * im) * sqrt(4.0) * ls_L1520_BW(sigma3) * hep.blatt_weisskopf(1, q3, 5.0) * hep.blatt_weisskopf(2, p3, 1.5)
% c08_L1520: L1520_BW, J = 3/2, chain (12)3, production: LS coupling, L = 2, S = 3/2, decay: LS coupling, L = 2, S = 1/2
c08_L1520 = (-5.803165988479272 + 10.325839240068499 * im) * sqrt(4.0) * ls_L1520_BW(sigma3) * hep.blatt_weisskopf(2, q3, 5.0) * hep.blatt_weisskopf(2, p3, 1.5)
% c09_L1520: L1520_BW, J = 3/2, chain (12)3, production: LS coupling, L = 2, S = 5/2, decay: LS coupling, L = 2, S = 1/2
c09_L1520 = (5.0240140735133085 - 3.4922186723465236 * im) * sqrt(4.0) * ls_L1520_BW(sigma3) * hep.blatt_weisskopf(2, q3, 5.0) * hep.blatt_weisskopf(2, p3, 1.5)
% c10_L1520: L1520_BW, J = 3/2, chain (12)3, production: LS coupling, L = 3, S = 5/2, decay: LS coupling, L = 2, S = 1/2
c10_L1520 = (4.749762166036306 - 6.557080951190571 * im) * sqrt(4.0) * ls_L1520_BW(sigma3) * hep.blatt_weisskopf(3, q3, 5.0) * hep.blatt_weisskopf(2, p3, 1.5)
% c11_L1600: L1600_BW, J = 1/2, chain (12)3, production: LS coupling, L = 0, S = 1/2, decay: LS coupling, L = 1, S = 1/2
c11_L1600 = (-4.984604534495612 - 7.275774343593705 * im) * sqrt(2.0) * ls_L1600_BW(sigma3) * hep.blatt_weisskopf(1, p3, 1.5)
