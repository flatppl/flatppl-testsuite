a = elementof(reals)
lo = elementof(reals)
hi = elementof(reals)
point = elementof(reals)
measure = normalize(logweighted(t -> a*t, Lebesgue(interval(lo, hi))))
score = functionof(logdensityof(measure, point), a=a, lo=lo, hi=hi, point=point)
rates = [0.7, 2.0, 5.0]
lows = [-0.2, 0.0, 0.5]
highs = [1.3, 0.9, 1.2]
points = [0.4, 0.3, 0.9]
