sigma = elementof(reals)
rate = elementof(reals)
probs = elementof(cartpow(reals, 3))
shape = elementof(reals)
x = elementof(reals)
k = elementof(integers)
c = elementof(integers)
y = elementof(reals)
lp = logdensityof(Normal(0.5, sigma), x) + logdensityof(Poisson(rate), k) + logdensityof(Categorical(probs), c) + logdensityof(Gamma(shape, 2.0), y)
