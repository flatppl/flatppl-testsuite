      "modes": [
        "logdensity",
        "sample"
      ],
      "grad_params": [
        "shape",
        "rate"
      ],
      "sample_distributional": true,
      "sample_discrete": false,
      "independence": null,
      "fanout_n": 200,
      "fanout_dim": null,
      "notes": "exercises chlo.lgamma; fan-out exercises the batched Marsaglia-Tsang rejection while"
