%%%
# Cumulative ops in a broadcast callable, 2 rows of 5

Each of the 2 rows of `x` is scanned by a callable that a broadcast maps
over the row indices. The scan's operand is one row per broadcast cell.
%%%
flatppl_compat = "0.1"

x = elementof(cartpow(reals, [2, 5]))
a = elementof(reals)
rows = indicesof(zeros(2))
cols = indicesof(zeros(5))
sums(j, m) = cumsum(m[j, cols])
peaks(j, m) = cummax(m[j, cols])
S = rowstack(sums.(rows, [x]))
M = rowstack(peaks.(rows, [x]))
