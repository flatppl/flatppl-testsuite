%%%
# Two-level binary HGF with softmax choices

Port of HierarchicalGaussianFiltering.jl's `binary_2level` HGF with
its default probability-node update and
`HGFSoftmax(target_state = :xprob_posterior_mean)`.
Six observed outcomes update a Gaussian belief about outcome log odds.
Choices follow the updated belief. Outcomes are fixed inputs, not scored data.
A scan carries the mean and precision through the observed outcomes.
%%%
flatppl_compat = "0.1"

u_data = [1, 0, 1, 1, 0, 0]
choice_data = [1, 0, 1, 0, 1, 0]

omega ~ Normal(-2, 1)
log_noise ~ Normal(0, 0.5)
action_noise = exp(log_noise)

# Unit coupling, zero drift, unit autoconnection, and unit time steps.
# The probability node uses ClassicUpdate: precision updates before the mean.
prediction_variance(precision) = 1 / precision + exp(omega)
posterior_precision(mean, precision) = 1 / prediction_variance(precision) + invlogit(mean) * (1 - invlogit(mean))
step(mean, precision, input) = record(
    mean = mean + (input - invlogit(mean)) / posterior_precision(mean, precision),
    precision = posterior_precision(mean, precision)
)

s0 = record(mean = 0, precision = 1)
update(state, input) = step(state.mean, state.precision, input)
states = scan(update, s0, u_data)
state_mean(state) = state.mean
state_precision(state) = state.precision
means = state_mean.(states)
precisions = state_precision.(states)
choice_probability = invlogit.(means ./ action_noise)
choice ~ Bernoulli.(choice_probability)

prior = lawof(record(omega = omega, log_noise = log_noise))
forward_kernel = kernelof(record(choice = choice), omega = omega, log_noise = log_noise)
L = likelihoodof(forward_kernel, record(choice = choice_data))
posterior = bayesupdate(L, prior)

mean_trajectory = functionof(means, omega = omega)
precision_trajectory = functionof(precisions, omega = omega)
choice_probabilities = functionof(choice_probability, omega = omega, log_noise = log_noise)
default_pars = record(omega = -2, log_noise = 0)
