%%%
# Flat prior with a latent upper bound

The conditional prior on `x` has constant density on `[0, bound]`.
It is not divided by the interval width: replacing `Flat` with `Uniform`
would add `-log(bound)` and change the posterior.
%%%
flatppl_compat = "0.1"

reg = standard_module("regression", "0.1")
y_data = 0.4

bound ~ Exponential(1.3)
x ~ reg.Flat(interval(0, bound))
prior = lawof(record(bound = bound, x = x))

y ~ Normal(x, 0.6)
forward_kernel = kernelof(y, bound = bound, x = x)
L = likelihoodof(forward_kernel, y_data)
posterior = bayesupdate(L, prior)
