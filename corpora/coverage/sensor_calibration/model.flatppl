%%%
# Sensor-array calibration through an `aggregate` linear predictor

A known 8 x 3 design matrix maps three gain coefficients to eight
predicted sensor readings; readings carry Gaussian noise of known
scale. Ordinary linear regression, except the linear predictor is
built with `aggregate(sum, [.i], X[.i, .j] * beta[.j])` — the
index-labelled Einstein-summation primitive (§04) — with the LATENT
`beta` inside the aggregate body, rather than with broadcast dot
products. That einsum-into-likelihood combination is what this fixture
scores.
%%%
flatppl_compat = "0.1"

X = rowstack([
    [0.57, -0.384, 0.306],
    [-0.449, 0.622, 0.821],
    [-1.383, 0.213, 1.351],
    [-0.352, -0.499, 0.455],
    [-1.104, -1.479, 1.251],
    [0.319, 0.277, 1.557],
    [1.528, -1.048, 0.097],
    [1.359, -1.219, 0.016],
])

% Generated at beta = (1.2, -0.7, 0.4), noise sigma 0.5 (numpy seed 7331).
y_obs = [0.515, -1.0269, -1.0278, -0.796, 0.4253, 1.2745, 2.2125, 2.9271]

beta ~ iid(Normal(mu = 0.0, sigma = 1.0), 3)

mu_pred = aggregate(sum, [.i], X[.i, .j] * beta[.j])
y ~ Normal.(mu_pred, 0.5)

prior = lawof(record(beta = beta))
forward_kernel = kernelof(record(y = y), beta = beta)
L = likelihoodof(forward_kernel, record(y = y_obs))
posterior = bayesupdate(L, prior)
