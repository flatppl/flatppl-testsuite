% Mode ABI: one query, both engines. `sigma_step` and `drift` are model draws, so the scored free parameters take the `_v` suffix.
sigma_step_v = elementof(posreals)
drift_v = elementof(reals)
lp = logdensityof(Pi_post, record(sigma_step = sigma_step_v, drift = drift_v))
inputs = (sigma_step_v, drift_v)
outputs = (lp)
