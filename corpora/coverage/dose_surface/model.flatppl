%%%
# Dose-response surface with explicit callback parameters

The unit-square base has density one. Both weights receive the whole
variate and produce dose * time^2: w1 fixes the exponent at two, while
w2 receives it as the final parameter. Their summed log densities are
2 * log(0.5 * 0.8^2).
%%%
flatppl_compat = "0.1"

square = iid(Uniform(interval(0.0, 1.0)), 2)

w2 = (v, exponent) -> v[1] * v[2]^exponent
m2 = weighted(w2, square, 2)
lp2 = logdensityof(m2, [0.5, 0.8])

w1 = v -> v[1] * v[2]^2
m1 = weighted(w1, square)
lp1 = logdensityof(m1, [0.5, 0.8])

lp = lp1 + lp2
