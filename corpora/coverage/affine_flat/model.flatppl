%%%
# Flat priors on affine supports

Both priors have unit density relative to their coordinate reference measures.
The score is zero only when the zero-sum and simplex constraints hold.
%%%
flatppl_compat = "0.1"

reg = standard_module("regression", "0.1")
effects ~ reg.Flat(zerosum(3))
weights ~ reg.Flat(stdsimplex(3))
prior = lawof(record(effects = effects, weights = weights))
