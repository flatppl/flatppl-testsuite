%%%
# Radon, complete pooling

PosteriorDB's `radon_mn-radon_pooled`. Log radon depends on the floor of
measurement, with one intercept and slope for all counties. The normalized
half-Normal scale prior adds log(2) to Stan's target.
%%%
flatppl_compat = "0.1"

N = 919
J = 85
data = load_data("data/radon_mn.json", cartprod(
    county_idx = cartpow(posintegers, N), floor_measure = cartpow(reals, N),
    log_radon = cartpow(reals, N)))

alpha ~ Normal(0, 10)
beta ~ Normal(0, 10)
sigma_y ~ normalize(truncate(Normal(0, 1), interval(0, inf)))
y ~ Normal.(alpha .+ beta .* data.floor_measure, sigma_y)

Pi_prior = lawof(record(alpha = alpha, beta = beta, sigma_y = sigma_y))
K_model = kernelof(record(y = y), alpha = alpha, beta = beta, sigma_y = sigma_y)
L = likelihoodof(K_model, record(y = data.log_radon))
Pi_post = bayesupdate(L, Pi_prior)
Pi_post_domain = cartprod(alpha = reals, beta = reals, sigma_y = posreals)
Pi_post_input = record(alpha = 1.36, beta = -0.59, sigma_y = 0.79)
