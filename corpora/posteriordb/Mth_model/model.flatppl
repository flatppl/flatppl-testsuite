%%%
# Capture-recapture with occasion and individual effects

PosteriorDB's `Mth_data-Mth_model`. Each augmented animal belongs to the
population with probability omega. A present animal is captured on occasion
t with logit(mean_p[t]) plus an individual effect sigma * eps_raw. Absent
animals are never captured. The mixture marginalizes membership for each
capture history. The scale is uniform on (0, 5); normalizing it adds -log(5)
to Stan's target.
%%%
flatppl_compat = "0.1"

M = 387
T = 5
data = load_data("data/Mth_data.json", cartprod(y = cartpow(nonnegintegers, [M, T])))

omega ~ Uniform(unitinterval)
mean_p ~ iid(Uniform(unitinterval), T)
sigma ~ Uniform(interval(0, 5))
eps_raw ~ iid(Normal(0, 1), M)
lp = addaxes(sigma .* eps_raw, 0, 1) .+ addaxes(logit.(mean_p), 1, 0)
capture(row, omega) = normalize(superpose(
    weighted(omega, Bernoulli.(invlogit.(row))), weighted(1 - omega, Dirac(fill(false, [1, T])))))
y ~ capture.(splitblocks(lp, [1, T]), omega)

Pi_prior = lawof(record(omega = omega, mean_p = mean_p, sigma = sigma, eps_raw = eps_raw))
K_model = kernelof(record(y = y), omega = omega, mean_p = mean_p, sigma = sigma, eps_raw = eps_raw)
L = likelihoodof(K_model, record(y = splitblocks(data.y, [1, T])))
Pi_post = bayesupdate(L, Pi_prior)
Pi_post_domain = cartprod(omega = interval(0.0, 1.0), mean_p = cartpow(interval(0.0, 1.0), 5), sigma = interval(0.0, 5.0), eps_raw = cartpow(reals, 387))
Pi_post_input = record(omega = 0.292, mean_p = [0.539, 0.353, 0.402, 0.532, 0.462], sigma = 0.732, eps_raw = fill(0.0, 387))
