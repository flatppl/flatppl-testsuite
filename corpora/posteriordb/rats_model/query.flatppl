p_sigma_y = elementof(posreals)
p_sigma_alpha = elementof(posreals)
p_sigma_beta = elementof(posreals)
p_alpha = elementof(cartpow(reals, 30))
p_beta = elementof(cartpow(reals, 30))
p_mu_alpha = elementof(reals)
p_mu_beta = elementof(reals)
inputs = (p_sigma_y, p_sigma_alpha, p_sigma_beta, p_alpha, p_beta, p_mu_alpha, p_mu_beta)
outputs = logdensityof(Pi_post, record(sigma_y = p_sigma_y, sigma_alpha = p_sigma_alpha, sigma_beta = p_sigma_beta, alpha = p_alpha, beta = p_beta, mu_alpha = p_mu_alpha, mu_beta = p_mu_beta))
