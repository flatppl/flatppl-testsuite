%%%
# Log mesquite weight on canopy volume

PosteriorDB's `mesquite-logmesquite_logvolume`. Log shrub weight depends
linearly on log canopy volume. Both the coefficients and the residual scale
have flat priors.
%%%
flatppl_compat = "0.1"

N = 46
data = load_data("data/mesquite.json", cartprod(
    weight = cartpow(reals, N),
    diam1 = cartpow(reals, N),
    diam2 = cartpow(reals, N),
    canopy_height = cartpow(reals, N)))
canopy_volume = data.diam1 .* data.diam2 .* data.canopy_height
X = colstack([ones(N), log.(canopy_volume)])

beta = elementof(cartpow(reals, 2))
sigma = elementof(posreals)
y ~ Normal.(X * beta, sigma)

Pi_prior = Lebesgue(cartprod(beta = cartpow(reals, 2), sigma = posreals))
K_model = kernelof(record(y = y), beta = beta, sigma = sigma)
L = likelihoodof(K_model, record(y = log.(data.weight)))
Pi_post = bayesupdate(L, Pi_prior)
Pi_post_domain = cartprod(beta = cartpow(reals, 2), sigma = posreals)
Pi_post_input = record(beta = [5.17, 0.722], sigma = 0.427)
