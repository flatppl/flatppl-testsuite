%%%
# Capture-recapture with unobserved animals

PosteriorDB's `M0_data-M0_model`. Each augmented animal belongs to the
population with probability omega. Present animals have a Binomial capture
total, while absent animals have zero captures. The mixture marginalizes
population membership separately for each animal.
%%%
flatppl_compat = "0.1"

M = 237
T = 3
data = load_data("data/M0_data.json", cartprod(y = cartpow(nonnegintegers, [M, T])))
capture_totals = aggregate(sum, [.i], data.y[.i, .j])

omega ~ Uniform(unitinterval)
p ~ Uniform(unitinterval)
capture_total = normalize(superpose(
    weighted(omega, Binomial(T, p)), weighted(1 - omega, Dirac(0))))
y ~ iid(capture_total, M)

Pi_prior = lawof(record(omega = omega, p = p))
K_model = kernelof(record(y = y), omega = omega, p = p)
L = likelihoodof(K_model, record(y = capture_totals))
Pi_post = bayesupdate(L, Pi_prior)
Pi_post_domain = cartprod(omega = unitinterval, p = unitinterval)
Pi_post_input = record(omega = 0.5, p = 0.5)
