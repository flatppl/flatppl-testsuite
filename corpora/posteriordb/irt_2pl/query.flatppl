p_sigma_theta = elementof(posreals)
p_theta = elementof(cartpow(reals, 100))
p_sigma_a = elementof(posreals)
p_a = elementof(cartpow(posreals, 20))
p_mu_b = elementof(reals)
p_sigma_b = elementof(posreals)
p_b = elementof(cartpow(reals, 20))
inputs = (p_sigma_theta, p_theta, p_sigma_a, p_a, p_mu_b, p_sigma_b, p_b)
outputs = logdensityof(Pi_post, record(sigma_theta = p_sigma_theta, theta = p_theta, sigma_a = p_sigma_a, a = p_a, mu_b = p_mu_b, sigma_b = p_sigma_b, b = p_b))
