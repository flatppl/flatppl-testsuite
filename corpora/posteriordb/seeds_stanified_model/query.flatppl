p_alpha0 = elementof(reals)
p_alpha1 = elementof(reals)
p_alpha12 = elementof(reals)
p_alpha2 = elementof(reals)
p_b = elementof(cartpow(reals, 21))
p_sigma = elementof(posreals)
inputs = (p_alpha0, p_alpha1, p_alpha12, p_alpha2, p_b, p_sigma)
outputs = logdensityof(Pi_post, record(alpha0 = p_alpha0, alpha1 = p_alpha1, alpha12 = p_alpha12, alpha2 = p_alpha2, b = p_b, sigma = p_sigma))
