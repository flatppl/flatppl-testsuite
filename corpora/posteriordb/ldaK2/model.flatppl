%%%
# Latent Dirichlet allocation with two topics

PosteriorDB's `three_docs1200-ldaK2`. Three documents of 400 words use a
vocabulary of three words. Each document mixes two topics with weights
theta, and each topic draws words with probabilities phi. Summing over the
topic of each word gives the word probabilities theta * phi. All simplex
priors are uniform.
%%%
flatppl_compat = "0.1"

V = 3
M = 3
N = 1200
K = 2
data = load_data("data/three_docs1200.json", cartprod(
    w = cartpow(posintegers, N), doc = cartpow(posintegers, N)))

theta ~ iid(Dirichlet(ones(K)), M)
phi ~ iid(Dirichlet(ones(V)), K)
word_probs = rowstack(theta) * rowstack(phi)
document_words = [word_probs[1, :], word_probs[2, :], word_probs[3, :]]
w ~ Categorical.(document_words[data.doc])

Pi_prior = lawof(record(theta = theta, phi = phi))
K_model = kernelof(record(w = w), theta = theta, phi = phi)
L = likelihoodof(K_model, record(w = data.w))
Pi_post = bayesupdate(L, Pi_prior)
Pi_post_domain = cartprod(theta = cartpow(stdsimplex(K), M), phi = cartpow(stdsimplex(V), K))
Pi_post_input = record(theta = fill(fill(1 / K, K), M), phi = fill(fill(1 / V, V), K))
