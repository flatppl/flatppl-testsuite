outputs = logdensityof(Pi_post, record(sigma_y = p_sigma_y, sigma_alpha = p_sigma_alpha, sigma_beta = p_sigma_beta, alpha_raw = p_alpha_raw, beta_raw = p_beta_raw, mu_alpha = p_mu_alpha, mu_beta = p_mu_beta))
