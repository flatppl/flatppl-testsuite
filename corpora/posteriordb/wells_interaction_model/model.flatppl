%%%
# Switching wells: distance-arsenic interaction

PosteriorDB's `wells_data-wells_interaction_model`. Logistic regression of
switching on distance in hundreds of metres, arsenic level and their
product. The intercept and the coefficients have flat priors.
%%%
flatppl_compat = "0.1"

N = 3020
data = load_data("data/wells_data.json", cartprod(
    switched = cartpow(nonnegintegers, N),
    dist = cartpow(reals, N),
    arsenic = cartpow(reals, N)))
dist100 = data.dist ./ 100
X = colstack([dist100, data.arsenic, dist100 .* data.arsenic])

alpha = elementof(reals)
beta = elementof(cartpow(reals, 3))
y ~ Bernoulli.(invlogit.(alpha .+ X * beta))

Pi_prior = Lebesgue(cartprod(alpha = reals, beta = cartpow(reals, 3)))
K_model = kernelof(record(y = y), alpha = alpha, beta = beta)
L = likelihoodof(K_model, record(y = data.switched))
Pi_post = bayesupdate(L, Pi_prior)
Pi_post_domain = cartprod(alpha = reals, beta = cartpow(reals, 3))
Pi_post_input = record(alpha = -0.148, beta = [-0.577, 0.556, -0.179])
