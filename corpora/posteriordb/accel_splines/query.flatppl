p_Intercept = elementof(reals)
p_zs_1_1 = elementof(cartpow(reals, 38))
p_sds_1_1 = elementof(posreals)
p_Intercept_sigma = elementof(reals)
p_zs_sigma_1_1 = elementof(cartpow(reals, 38))
p_sds_sigma_1_1 = elementof(posreals)
p_bs = elementof(cartpow(reals, 1))
p_bs_sigma = elementof(cartpow(reals, 1))
inputs = (p_Intercept, p_zs_1_1, p_sds_1_1, p_Intercept_sigma, p_zs_sigma_1_1, p_sds_sigma_1_1, p_bs, p_bs_sigma)
outputs = logdensityof(Pi_post, record(Intercept = p_Intercept, zs_1_1 = p_zs_1_1, sds_1_1 = p_sds_1_1, Intercept_sigma = p_Intercept_sigma, zs_sigma_1_1 = p_zs_sigma_1_1, sds_sigma_1_1 = p_sds_sigma_1_1, bs = p_bs, bs_sigma = p_bs_sigma))
