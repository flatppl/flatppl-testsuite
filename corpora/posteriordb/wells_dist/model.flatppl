%%%
# Switching wells by distance

PosteriorDB's `wells_data-wells_dist`. A logistic regression relates each
household's decision to switch wells to the distance to the nearest safe
well. Both coefficients have flat priors.
%%%
flatppl_compat = "0.1"

N = 3020
data = load_data("data/wells_data.json", cartprod(
    switched = cartpow(nonnegintegers, N), dist = cartpow(reals, N)))

beta = elementof(cartpow(reals, 2))
y ~ Bernoulli.(invlogit.(beta[1] .+ beta[2] .* data.dist))

Pi_prior = Lebesgue(cartprod(beta = cartpow(reals, 2)))
K_model = kernelof(record(y = y), beta = beta)
L = likelihoodof(K_model, record(y = data.switched))
Pi_post = bayesupdate(L, Pi_prior)
Pi_post_domain = cartprod(beta = cartpow(reals, 2))
Pi_post_input = record(beta = [0.6, -0.006])
