%%%
# Common rate of two counts

PosteriorDB's `Rate_5_data-Rate_5_model`. Two binomial counts share one rate
with a uniform Beta(1, 1) prior. This is the Rate_3 model on another data
set.
%%%
flatppl_compat = "0.1"

data = load_data("data/Rate_5_data.json", cartprod(
    n1 = posintegers, n2 = posintegers, k1 = nonnegintegers, k2 = nonnegintegers))

theta ~ Beta(1, 1)
k1 ~ Binomial(data.n1, theta)
k2 ~ Binomial(data.n2, theta)

Pi_prior = lawof(record(theta = theta))
K_model = kernelof(record(k1 = k1, k2 = k2), theta = theta)
L = likelihoodof(K_model, record(k1 = data.k1, k2 = data.k2))
Pi_post = bayesupdate(L, Pi_prior)
Pi_post_domain = cartprod(theta = unitinterval)
Pi_post_input = record(theta = 0.499)
