%%%
# Survey returns with an unknown population size

PosteriorDB's `Survey_data-Survey_model`. Five return counts share one
unknown population size, uniformly distributed from 1 to 500. A mixture of
five-count distributions marginalizes that size and retains theta as the
sole fitted parameter. Impossible sizes retain zero likelihood.
%%%
flatppl_compat = "0.1"

data = load_data("data/Survey_data.json", cartprod(
    nmax = posintegers, m = posintegers, k = cartpow(nonnegintegers, 5)))

theta ~ Uniform(unitinterval)
counts(n) = iid(Binomial(n, theta), 5)
possible_sizes = indicesof(zeros(500))
population_weights = ones(500)
y ~ normalize(ksuperpose(counts, population_weights)(possible_sizes))

Pi_prior = lawof(record(theta = theta))
K_model = kernelof(record(y = y), theta = theta)
L = likelihoodof(K_model, record(y = data.k))
Pi_post = bayesupdate(L, Pi_prior)
Pi_post_domain = cartprod(theta = unitinterval)
Pi_post_input = record(theta = 0.1)
