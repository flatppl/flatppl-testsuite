p_alpha_raw = elementof(cartpow(reals, 85))
p_beta = elementof(cartpow(reals, 2))
p_mu_alpha = elementof(reals)
p_sigma_alpha = elementof(posreals)
p_sigma_y = elementof(posreals)
inputs = (p_alpha_raw, p_beta, p_mu_alpha, p_sigma_alpha, p_sigma_y)
outputs = logdensityof(Pi_post, record(alpha_raw = p_alpha_raw, beta = p_beta, mu_alpha = p_mu_alpha, sigma_alpha = p_sigma_alpha, sigma_y = p_sigma_y))
