p_a = elementof(cartpow(reals, 5))
p_b = elementof(cartpow(reals, 8))
p_mu_a = elementof(reals)
p_mu_b = elementof(reals)
p_sigma_a = elementof(interval(0.0, 100.0))
p_sigma_b = elementof(interval(0.0, 100.0))
p_sigma_y = elementof(interval(0.0, 100.0))
inputs = (p_a, p_b, p_mu_a, p_mu_b, p_sigma_a, p_sigma_b, p_sigma_y)
outputs = logdensityof(Pi_post, record(a = p_a, b = p_b, mu_a = p_mu_a, mu_b = p_mu_b, sigma_a = p_sigma_a, sigma_b = p_sigma_b, sigma_y = p_sigma_y))
