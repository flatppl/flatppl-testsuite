%%%
# Log earnings, height and sex

PosteriorDB's `earnings-logearn_height_male`. Log earnings depend linearly
on height and a male indicator. Both the coefficients and the residual scale
have flat priors.
%%%
flatppl_compat = "0.1"

N = 1192
data = load_data("data/earnings.json", cartprod(
    earn = cartpow(posreals, N),
    height = cartpow(posreals, N),
    male = cartpow(reals, N)))
X = colstack([ones(N), data.height, data.male])

beta = elementof(cartpow(reals, 3))
sigma = elementof(posreals)
y ~ Normal.(X * beta, sigma)

Pi_prior = Lebesgue(cartprod(beta = cartpow(reals, 3), sigma = posreals))
K_model = kernelof(record(y = y), beta = beta, sigma = sigma)
L = likelihoodof(K_model, record(y = log.(data.earn)))
Pi_post = bayesupdate(L, Pi_prior)
Pi_post_domain = cartprod(beta = cartpow(reals, 3), sigma = posreals)
Pi_post_input = record(beta = [8.16, 0.0206, 0.424], sigma = 0.882)
