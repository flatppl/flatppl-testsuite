%%%
# Learning from shocks, logistic form

PosteriorDB's `dogs-dogs`. Each of 30 dogs faces 25 trials. The log-odds of
a shock are linear in the numbers of earlier avoidances and shocks, with
Normal(0, 100) coefficient priors. The likelihood conditions on observed
histories.
%%%
flatppl_compat = "0.1"

J = 30
T = 25
data = load_data("data/dogs.json", cartprod(y = cartpow(nonnegintegers, [J, T])))
dogs = indicesof(zeros(J))
previous_trials = indicesof(zeros(T - 1))
shock_history(j) = cat([0], scan((total, shock) -> total + shock,
    0, data.y[j, previous_trials]))
avoid_history(j) = (indicesof(zeros(T)) .- 1) .- shock_history(j)
n_shock = rowstack(shock_history.(dogs))
n_avoid = rowstack(avoid_history.(dogs))

beta ~ iid(Normal(0, 100), 3)
y ~ Bernoulli.(invlogit.(beta[1] .+ beta[2] .* n_avoid .+ beta[3] .* n_shock))

Pi_prior = lawof(record(beta = beta))
K_model = kernelof(record(y = y), beta = beta)
L = likelihoodof(K_model, record(y = data.y))
Pi_post = bayesupdate(L, Pi_prior)
Pi_post_domain = cartprod(beta = cartpow(reals, 3))
Pi_post_input = record(beta = [1.78, -0.373, -0.211])
