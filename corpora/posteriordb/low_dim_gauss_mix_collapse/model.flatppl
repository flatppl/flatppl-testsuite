%%%
# Two-component Gaussian mixture, unordered

PosteriorDB's `low_dim_gauss_mix_collapse-low_dim_gauss_mix_collapse`. Each
observation is Normal(mu[1], sigma[1]) with probability theta, otherwise
Normal(mu[2], sigma[2]). The means are unordered. Normalizing the two half-
Normal scale priors adds 2 log(2) to Stan's target.
%%%
flatppl_compat = "0.1"

N = 1000
data = load_data("data/low_dim_gauss_mix_collapse.json", cartprod(y = cartpow(reals, N)))

mu ~ iid(Normal(0, 2), 2)
sigma ~ iid(normalize(truncate(Normal(0, 2), interval(0, inf))), 2)
theta ~ Beta(5, 5)
component = normalize(superpose(
    weighted(theta, Normal(mu[1], sigma[1])), weighted(1 - theta, Normal(mu[2], sigma[2]))))
y ~ iid(component, N)

Pi_prior = lawof(record(mu = mu, sigma = sigma, theta = theta))
K_model = kernelof(record(y = y), mu = mu, sigma = sigma, theta = theta)
L = likelihoodof(K_model, record(y = data.y))
Pi_post = bayesupdate(L, Pi_prior)
Pi_post_domain = cartprod(mu = cartpow(reals, 2), sigma = cartpow(posreals, 2), theta = interval(0.0, 1.0))
Pi_post_input = record(mu = [-0.972, 0.168], sigma = [1.05, 1.23], theta = 0.366)
