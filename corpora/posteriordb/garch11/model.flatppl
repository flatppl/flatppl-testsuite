%%%
# GARCH(1,1) volatility

PosteriorDB's `garch-garch11`. Each return is Normal around mu. Its variance
is alpha0 plus alpha1 times the previous squared residual plus beta1 times
the previous variance. The first scale sigma1 is data. The mean and the
baseline variance have flat priors. The pair (alpha1, beta1) is uniform on
the region alpha1 + beta1 < 1. Normalizing that uniform law adds log(2) to
Stan's target.
%%%
flatppl_compat = "0.1"

T = 200
data = load_data("data/garch.json", cartprod(y = cartpow(reals, T), sigma1 = posreals))
previous = data.y[indicesof(zeros(T - 1))]

mu = elementof(reals)
alpha0 = elementof(posreals)
alpha1 ~ Beta(1, 2)
beta1 ~ Uniform(interval(0, 1 - alpha1))
step(sigma, y_previous, p) =
    sqrt(p.alpha0 + p.alpha1 * (y_previous - p.mu)^2 + p.beta1 * sigma^2)
sigma = cat([data.sigma1], scan(step, data.sigma1, previous,
    record(mu = mu, alpha0 = alpha0, alpha1 = alpha1, beta1 = beta1)))
y ~ Normal.(mu, sigma)

Pi_proper = lawof(record(alpha1 = alpha1, beta1 = beta1))
Pi_improper = Lebesgue(cartprod(mu = reals, alpha0 = posreals))
Pi_prior = joint(Pi_improper, Pi_proper)
K_model = kernelof(record(y = y), mu = mu, alpha0 = alpha0, alpha1 = alpha1, beta1 = beta1)
L = likelihoodof(K_model, record(y = data.y))
Pi_post = bayesupdate(L, Pi_prior)
Pi_post_domain = cartprod(mu = reals, alpha0 = posreals, alpha1 = unitinterval, beta1 = unitinterval)
Pi_post_input = record(mu = 5.0, alpha0 = 1.5, alpha1 = 0.55, beta1 = 0.3)
