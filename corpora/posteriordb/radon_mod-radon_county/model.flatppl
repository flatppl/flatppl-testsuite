%%%
# Radon by county, national data

PosteriorDB's `radon_mod-radon_county`. Log radon in 12573 homes is Normal
around one mean per county. The 386 county means are Normal around mu_a.
Both scales are uniform on (0, 100). Normalizing those priors adds -2
log(100) to Stan's target.
%%%
flatppl_compat = "0.1"

N = 12573
J = 386
data = load_data("data/radon_mod.json", cartprod(
    county = cartpow(posintegers, N), y = cartpow(reals, N)))

mu_a ~ Normal(0, 1)
sigma_a ~ Uniform(interval(0, 100))
sigma_y ~ Uniform(interval(0, 100))
a ~ iid(Normal(mu_a, sigma_a), J)
y ~ Normal.(a[data.county], sigma_y)

Pi_prior = lawof(record(a = a, mu_a = mu_a, sigma_a = sigma_a, sigma_y = sigma_y))
K_model = kernelof(record(y = y), a = a, mu_a = mu_a, sigma_a = sigma_a, sigma_y = sigma_y)
L = likelihoodof(K_model, record(y = data.y))
Pi_post = bayesupdate(L, Pi_prior)
Pi_post_domain = cartprod(a = cartpow(reals, J), mu_a = reals, sigma_a = interval(0, 100),
    sigma_y = interval(0, 100))
Pi_post_input = record(a = fill(1.3, J), mu_a = 1.3, sigma_a = 0.5, sigma_y = 0.8)
