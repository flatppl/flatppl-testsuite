inputs = (p_a, p_b, p_c, p_d, p_e, p_beta, p_sigma_a, p_sigma_b, p_sigma_c, p_sigma_d, p_sigma_e)
outputs = logdensityof(Pi_post, record(a = p_a, b = p_b, c = p_c, d = p_d, e = p_e, beta = p_beta, sigma_a = p_sigma_a, sigma_b = p_sigma_b, sigma_c = p_sigma_c, sigma_d = p_sigma_d, sigma_e = p_sigma_e))
