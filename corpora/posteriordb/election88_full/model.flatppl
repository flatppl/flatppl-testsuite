%%%
# Bush vote in the 1988 election

PosteriorDB's `election88-election88_full`. A logistic regression of the
Bush vote for 11566 survey respondents. Fixed effects for race, sex, their
product and the previous state vote join varying intercepts for age,
education, age by education, state and region. All five group scales are
uniform on (0, 100); normalizing them adds -5 log(100) to Stan's target.
%%%
flatppl_compat = "0.1"

N = 11566
data = load_data("data/election88.json", cartprod(
    age = cartpow(posintegers, N), edu = cartpow(posintegers, N), age_edu = cartpow(posintegers, N),
    state = cartpow(posintegers, N), region_full = cartpow(posintegers, N),
    black = cartpow(reals, N), female = cartpow(reals, N), v_prev_full = cartpow(reals, N),
    y = cartpow(nonnegintegers, N)))

sigma_a ~ Uniform(interval(0, 100))
sigma_b ~ Uniform(interval(0, 100))
sigma_c ~ Uniform(interval(0, 100))
sigma_d ~ Uniform(interval(0, 100))
sigma_e ~ Uniform(interval(0, 100))
a ~ iid(Normal(0, sigma_a), 4)
b ~ iid(Normal(0, sigma_b), 4)
c ~ iid(Normal(0, sigma_c), 16)
d ~ iid(Normal(0, sigma_d), 51)
e ~ iid(Normal(0, sigma_e), 5)
beta ~ iid(Normal(0, 100), 5)
y_hat = beta[1] .+ beta[2] .* data.black .+ beta[3] .* data.female .+
    beta[5] .* data.female .* data.black .+ beta[4] .* data.v_prev_full .+
    a[data.age] .+ b[data.edu] .+ c[data.age_edu] .+ d[data.state] .+ e[data.region_full]
y ~ Bernoulli.(invlogit.(y_hat))

Pi_prior = lawof(record(a = a, b = b, c = c, d = d, e = e, beta = beta, sigma_a = sigma_a, sigma_b = sigma_b, sigma_c = sigma_c, sigma_d = sigma_d, sigma_e = sigma_e))
K_model = kernelof(record(y = y), a = a, b = b, c = c, d = d, e = e, beta = beta, sigma_a = sigma_a, sigma_b = sigma_b, sigma_c = sigma_c, sigma_d = sigma_d, sigma_e = sigma_e)
L = likelihoodof(K_model, record(y = data.y))
Pi_post = bayesupdate(L, Pi_prior)
Pi_post_domain = cartprod(a = cartpow(reals, 4), b = cartpow(reals, 4), c = cartpow(reals, 16), d = cartpow(reals, 51), e = cartpow(reals, 5), beta = cartpow(reals, 5), sigma_a = interval(0.0, 100.0), sigma_b = interval(0.0, 100.0), sigma_c = interval(0.0, 100.0), sigma_d = interval(0.0, 100.0), sigma_e = interval(0.0, 100.0))
Pi_post_input = record(a = [0.000828, 0.027, 0.000362, 0.00518], b = [-0.0503, 0.0713, 0.0667, -0.0327], c = fill(0.0, 16), d = fill(0.0, 51), e = [1.04, 1.04, 1.64, 0.638, 1.33], beta = [-3.12, -2.01, -0.131, 4.46, 0.124], sigma_a = 0.0165, sigma_b = 0.0455, sigma_c = 0.189, sigma_d = 0.368, sigma_e = 0.904)
