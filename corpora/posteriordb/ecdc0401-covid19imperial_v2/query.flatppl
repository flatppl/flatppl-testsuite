p_alpha_hier = elementof(cartpow(posreals, 6))
p_kappa = elementof(posreals)
p_y = elementof(cartpow(posreals, 14))
p_phi = elementof(posreals)
p_tau = elementof(posreals)
p_ifr_noise = elementof(cartpow(posreals, 14))
p_mu = elementof(cartpow(posreals, 14))
inputs = (p_alpha_hier, p_kappa, p_y, p_phi, p_tau, p_ifr_noise, p_mu)
outputs = logdensityof(Pi_post, record(alpha_hier = p_alpha_hier, kappa = p_kappa, y = p_y, phi = p_phi, tau = p_tau, ifr_noise = p_ifr_noise, mu = p_mu))
