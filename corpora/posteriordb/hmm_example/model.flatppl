%%%
# Two-state hidden Markov model

PosteriorDB's `hmm_example-hmm_example`. A hidden two-state Markov chain
emits unit-variance Normal observations with state means mu. A scan over the
observed history runs the forward filter. Each observation is a two-component
mixture weighted by the predicted state probabilities. The product of these
mixtures is the forward-algorithm likelihood.

The transition rows are uniform on the simplex. The means keep Stan's
Normal(3, 1) and Normal(10, 1) densities on 0 < mu[1] < mu[2], without
renormalization. Stan starts the recursion with weight one for each state.
The uniform initial distribution here subtracts log(2) from Stan's target.
%%%
flatppl_compat = "0.1"

N = 100
data = load_data("data/hmm_example.json", cartprod(y = cartpow(reals, N)))

theta1 ~ Dirichlet([1.0, 1.0])
theta2 ~ Dirichlet([1.0, 1.0])
mu = elementof(ordered(2))
mu_prior = truncate(truncate(joint(Normal(3, 1), Normal(10, 1)), ordered(2)), cartpow(posreals, 2))

% Log-likelihood ratio of state 1 against state 2 for each observation.
log_ratio = 0.5 .* ((data.y .- mu[2]).^2 .- (data.y .- mu[1]).^2)
% Filter on the current observation, then predict state 1 for the next one.
predict(q, r, p) = p.theta2[1] + (p.theta1[1] - p.theta2[1]) * invlogit(logit(q) + r)
step(state, r, p) = record(current = state.next, next = predict(state.next, r, p))
states = scan(step, record(current = 0.5, next = 0.5), log_ratio,
    record(theta1 = theta1, theta2 = theta2))
state_weight(state) = state.current
weight = state_weight.(states)
emission(w, mu1, mu2) = normalize(superpose(
    weighted(w, Normal(mu1, 1)), weighted(1 - w, Normal(mu2, 1))))
y ~ emission.(weight, mu[1], mu[2])

Pi_prior = joint(lawof(record(theta1 = theta1, theta2 = theta2)), joint(mu = mu_prior))
K_model = kernelof(record(y = y), theta1 = theta1, theta2 = theta2, mu = mu)
L = likelihoodof(K_model, record(y = data.y))
Pi_post = bayesupdate(L, Pi_prior)
Pi_post_domain = cartprod(theta1 = stdsimplex(2), theta2 = stdsimplex(2), mu = ordered(2))
Pi_post_input = record(theta1 = [0.67, 0.33], theta2 = [0.07, 0.93], mu = [3.0, 9.0])
