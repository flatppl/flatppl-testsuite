%%%
# Poisson regression with year effects

PosteriorDB's `GLMM_Poisson_data-GLMM_Poisson_model`. Normal year effects
augment a cubic trend. This retains the original priors and coefficient bounds.
%%%
flatppl_compat = "0.1"

N = 40
data = load_data("data/GLMM_Poisson_data.json", cartprod(
    C = cartpow(nonnegintegers, N), year = cartpow(reals, N)))

alpha ~ Uniform(interval(-20, 20))
beta1 ~ Uniform(interval(-10, 10))
beta2 ~ Uniform(interval(-10, 10))
beta3 ~ Uniform(interval(-10, 10))
sigma ~ Uniform(interval(0, 5))
eps ~ iid(Normal(0, sigma), N)
eta = alpha .+ beta1 .* data.year .+ beta2 .* data.year.^2 .+ beta3 .* data.year.^3 .+ eps
y ~ Poisson.(exp.(eta))

Pi_prior = lawof(record(alpha = alpha, beta1 = beta1, beta2 = beta2,
                        beta3 = beta3, eps = eps, sigma = sigma))
K_model = kernelof(record(y = y), alpha = alpha, beta1 = beta1, beta2 = beta2,
                  beta3 = beta3, eps = eps, sigma = sigma)
L = likelihoodof(K_model, record(y = data.C))
Pi_post = bayesupdate(L, Pi_prior)
Pi_post_domain = cartprod(alpha = interval(-20, 20), beta1 = interval(-10, 10),
                          beta2 = interval(-10, 10), beta3 = interval(-10, 10),
                          eps = cartpow(reals, N), sigma = interval(0, 5))
Pi_post_input = record(alpha = 1.0, beta1 = 0.0, beta2 = 0.0,
                       beta3 = 0.0, eps = zeros(N), sigma = 1.0)
