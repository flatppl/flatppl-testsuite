p_alpha = elementof(reals)
p_beta = elementof(reals)
p_Omega = elementof(interval(0.0, 1.0))
p_rho_uv = elementof(interval(-1.0, 1.0))
p_sigma_uv = elementof(cartpow(posreals, 2))
p_uv1 = elementof(cartpow(reals, 50))
p_uv2 = elementof(cartpow(reals, 50))
inputs = (p_alpha, p_beta, p_Omega, p_rho_uv, p_sigma_uv, p_uv1, p_uv2)
outputs = logdensityof(Pi_post, record(alpha = p_alpha, beta = p_beta, Omega = p_Omega, rho_uv = p_rho_uv, sigma_uv = p_sigma_uv, uv1 = p_uv1, uv2 = p_uv2))
