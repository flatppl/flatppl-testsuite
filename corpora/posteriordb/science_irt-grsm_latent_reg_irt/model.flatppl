%%%
# Generalized rating scale model with latent regression

PosteriorDB's `science_irt-grsm_latent_reg_irt`. 392 persons answer 7 items
on a four-point scale (0 to 3). The response to item i by person j is
Categorical with probabilities softmax(cumsum([0, t - beta[i] - kappa])),
where t = alpha[i] * theta[j]. Item locations and step parameters sum to
zero: beta_free and kappa_free hold all but the last entry, which is minus
their sum. Stan adds normal_lpdf(beta | 0, 3) and normal_lpdf(kappa | 0, 3)
over the full vectors, a log weight on Lebesgue measure for the free parts.
Abilities are Normal around a regression on one covariate, a column of ones
that Stan's adjustment keeps as is.
%%%
flatppl_compat = "0.1"

I = 7
J = 392
N = 2744
K = 1
m = 3
data = load_data("data/science_irt.json", cartprod(
    ii = cartpow(posintegers, N), jj = cartpow(posintegers, N), y = cartpow(nonnegintegers, N),
    W = cartpow(reals, [J, K])))

alpha ~ iid(LogNormal(1, 1), I)
lambda_adj ~ iid(StudentT(3), K)
theta ~ Normal.(data.W * lambda_adj, 1)
beta_free = elementof(cartpow(reals, I - 1))
kappa_free = elementof(cartpow(reals, m - 1))
beta = cat(beta_free, [-sum(beta_free)])
kappa = cat(kappa_free, [-sum(kappa_free)])
rsm_probs(t, b, k) = softmax(cumsum(cat([0.0], t .- b .- k)))
y ~ Categorical.(rsm_probs.(alpha[data.ii] .* theta[data.jj], beta[data.ii], fill(kappa, N)))

location_weight(p) = (sum(logdensityof.(Normal(0, 3), cat(p.beta_free, [-sum(p.beta_free)])))
    + sum(logdensityof.(Normal(0, 3), cat(p.kappa_free, [-sum(p.kappa_free)]))))
Pi_location = logweighted(location_weight, Lebesgue(cartprod(
    beta_free = cartpow(reals, I - 1), kappa_free = cartpow(reals, m - 1))))
Pi_prior = joint(lawof(record(alpha = alpha, theta = theta, lambda_adj = lambda_adj)), Pi_location)
K_model = kernelof(record(y = y), alpha = alpha, theta = theta, lambda_adj = lambda_adj,
    beta_free = beta_free, kappa_free = kappa_free)
L = likelihoodof(K_model, record(y = data.y .+ 1))
Pi_post = bayesupdate(L, Pi_prior)
Pi_post_domain = cartprod(alpha = cartpow(posreals, 7), theta = cartpow(reals, 392), lambda_adj = cartpow(reals, 1), beta_free = cartpow(reals, 6), kappa_free = cartpow(reals, 2))
Pi_post_input = record(alpha = [0.315, 1.43, 0.123, 0.298, 1.32, 1.22, 0.163], theta = fill(0.0, 392), lambda_adj = [1.09], beta_free = [-0.622, 0.779, 0.00534, -0.261, 0.476, -0.144], kappa_free = [-1.22, -0.385])
