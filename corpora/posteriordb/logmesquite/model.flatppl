%%%
# Log mesquite weight

PosteriorDB's `mesquite-logmesquite`. Log shrub weight depends linearly on
five log measurements and the group. Both the coefficients and the residual
scale have flat priors.
%%%
flatppl_compat = "0.1"

N = 46
data = load_data("data/mesquite.json", cartprod(
    weight = cartpow(reals, N),
    diam1 = cartpow(reals, N),
    diam2 = cartpow(reals, N),
    canopy_height = cartpow(reals, N),
    total_height = cartpow(reals, N),
    density = cartpow(reals, N),
    group = cartpow(reals, N)))
X = colstack([ones(N), log.(data.diam1), log.(data.diam2), log.(data.canopy_height), log.(data.total_height), log.(data.density), data.group])

beta = elementof(cartpow(reals, 7))
sigma = elementof(posreals)
y ~ Normal.(X * beta, sigma)

Pi_prior = Lebesgue(cartprod(beta = cartpow(reals, 7), sigma = posreals))
K_model = kernelof(record(y = y), beta = beta, sigma = sigma)
L = likelihoodof(K_model, record(y = log.(data.weight)))
Pi_post = bayesupdate(L, Pi_prior)
Pi_post_domain = cartprod(beta = cartpow(reals, 7), sigma = posreals)
Pi_post_input = record(beta = [5.35, 0.399, 1.15, 0.377, 0.39, 0.109, -0.585], sigma = 0.341)
