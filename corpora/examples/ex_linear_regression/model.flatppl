%%%
# Bayesian linear regression

Simple normal linear regression with unknown intercept $\alpha$, slope $\beta$,
and observation noise $\sigma$. The noise scale is inferred via a
conjugate $\mathrm{InverseGamma}$ prior; the regression coefficients share that
scale, giving a weakly informative joint prior.
%%%
flatppl_compat = "0.1"

x_data = [1.1, 1.5, 1.3, 1.4]
y_data = [3.2, 4.1, 3.4, 3.9]

sigma_sq ~ InverseGamma(5, 5)
sigma = sqrt(sigma_sq)
alpha ~ Normal(0, sigma * 3)
beta ~ Normal(0, sigma * 3)

Pi_prior = lawof(record(alpha = alpha, beta = beta, sigma = sigma))

means = alpha .+ beta .* x_data

y ~ Normal.(means, sigma)

K_model = kernelof(record(y = y), alpha = alpha, beta = beta, sigma = sigma) % Forward kernel (observation model)

L = likelihoodof(K_model, record(y = y_data))

Pi_post = bayesupdate(L, Pi_prior)

% Point preset for likelihood
L_input = record(alpha = 0.55, beta = 2.34, sigma = 0.11)

% Domain preset for likelihood
L_domain = cartprod(
    alpha = interval(-1.0, 2.0),
    beta  = interval( 0.0, 4.0),
    sigma = interval(0.05, 0.5)
)
